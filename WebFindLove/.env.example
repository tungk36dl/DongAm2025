# Database Connection
DB_SERVER=your_server_name
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Redis Connection
REDIS_CONNECTION=localhost:6379

# JWT Settings
JWT_SECRET_KEY=your_jwt_secret_key_here

# Admin Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_admin_password

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Email Settings
SMTP_SERVER=smtp.gmail.com
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Azure SQL Database (for Production deployment)
# Use this for Azure SQL with Active Directory authentication
# Format: Server=tcp:server.database.windows.net;Authentication=Active Directory Default;Database=dbname;
AZURE_SQL_CONNECTION_STRING=Server=tcp:your-server.database.windows.net;Authentication=Active Directory Default;Database=your-database;
