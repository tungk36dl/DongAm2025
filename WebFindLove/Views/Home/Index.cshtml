@{
    ViewData["Title"] = "Home Page";
}

<div class="min-h-[80vh]">
    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-primary to-secondary rounded-2xl shadow-2xl p-12 text-white mb-12">
        <div class="text-center">
            <i class="fas fa-heart text-6xl mb-6 animate-pulse"></i>
            <h1 class="text-5xl font-bold mb-4">Welcome to WebFindLove</h1>
            <p class="text-xl text-pink-100 mb-8">Your journey to finding love starts here</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="bg-white/20 backdrop-blur-sm rounded-lg p-6 max-w-md mx-auto">
                    <p class="text-lg mb-4">Welcome back, <strong>@User.Identity.Name</strong>!</p>
                    <p class="text-pink-100">You are logged in as <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></p>
                </div>
            }
            else
            {
                <div class="flex justify-center space-x-4">
                    <a asp-controller="Auth" asp-action="Register" class="bg-white text-primary px-8 py-3 rounded-full font-semibold hover:bg-pink-50 transition transform hover:scale-105">
                        <i class="fas fa-user-plus mr-2"></i>Get Started
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="border-2 border-white text-white px-8 py-3 rounded-full font-semibold hover:bg-white/10 transition">
                        <i class="fas fa-sign-in-alt mr-2"></i>Login
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Features Section -->
    <div class="mb-12">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-8">
            <i class="fas fa-star text-primary mr-2"></i>Why Choose Us?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition transform hover:scale-105">
                <div class="text-center">
                    <div class="bg-gradient-to-r from-primary to-secondary w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-shield-alt text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Secure & Private</h3>
                    <p class="text-gray-600">Your information is protected with industry-leading security measures</p>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition transform hover:scale-105">
                <div class="text-center">
                    <div class="bg-gradient-to-r from-primary to-secondary w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-users text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Active Community</h3>
                    <p class="text-gray-600">Connect with thousands of singles looking for meaningful relationships</p>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-xl transition transform hover:scale-105">
                <div class="text-center">
                    <div class="bg-gradient-to-r from-primary to-secondary w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-heart text-3xl text-white"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-3">Perfect Matches</h3>
                    <p class="text-gray-600">Our smart algorithm helps you find your perfect match</p>
                </div>
            </div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Quick Actions for Admins -->
        @if (User.IsInRole("Admin"))
        {
            <div class="bg-white rounded-xl shadow-md p-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">
                    <i class="fas fa-cog text-primary mr-2"></i>Admin Dashboard
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <a asp-controller="Users" asp-action="Index" class="flex items-center p-4 border-2 border-gray-200 rounded-lg hover:border-primary hover:bg-pink-50 transition">
                        <div class="bg-gradient-to-r from-primary to-secondary w-12 h-12 rounded-full flex items-center justify-center mr-4">
                            <i class="fas fa-users text-xl text-white"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-800">Manage Users</h3>
                            <p class="text-sm text-gray-600">View and manage all users</p>
                        </div>
                    </a>

                    <a asp-controller="Roles" asp-action="Index" class="flex items-center p-4 border-2 border-gray-200 rounded-lg hover:border-primary hover:bg-pink-50 transition">
                        <div class="bg-gradient-to-r from-primary to-secondary w-12 h-12 rounded-full flex items-center justify-center mr-4">
                            <i class="fas fa-user-shield text-xl text-white"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-gray-800">Manage Roles</h3>
                            <p class="text-sm text-gray-600">Configure user roles and permissions</p>
                        </div>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Call to Action -->
        <div class="bg-gradient-to-r from-purple-500 to-pink-500 rounded-2xl shadow-xl p-12 text-white text-center">
            <h2 class="text-3xl font-bold mb-4">Ready to Find Your Perfect Match?</h2>
            <p class="text-xl mb-8 text-purple-100">Join thousands of happy couples who found love here</p>
            <a asp-controller="Auth" asp-action="Register" class="inline-block bg-white text-purple-600 px-8 py-4 rounded-full font-semibold text-lg hover:bg-purple-50 transition transform hover:scale-105">
                <i class="fas fa-heart mr-2"></i>Start Your Journey Today
            </a>
        </div>
    }
</div>
