@model WebFindLove.Models.User

@{
    ViewData["Title"] = "Đăng ký";
}

<div class="min-h-[80vh] flex items-center justify-center py-12">
    <div class="max-w-md w-full animate-fadeIn">
        <div class="text-center mb-8">
            <div class="inline-block mb-4 animate-bounce">
                <i class="fas fa-heart text-6xl text-primary drop-shadow-lg"></i>
            </div>
            <h2 class="text-3xl font-bold text-gray-800 dark:text-gray-100 bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">Tham gia WebFindLove</h2>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Tạo tài khoản và bắt đầu hành trình của bạn</p>
        </div>

        <div class="bg-white/95 dark:bg-gray-800/95 backdrop-blur-md rounded-2xl shadow-2xl p-8 border border-gray-200/50 dark:border-gray-700/50">
            <form method="post" asp-action="Register" asp-controller="Auth" id="registerForm">
                @Html.AntiForgeryToken()
                
                <div class="mb-5">
                    <label for="UserName" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-user mr-2"></i>Tên đăng nhập
                    </label>
                    <input type="text" 
                           id="UserName" 
                           name="UserName"
                           asp-for="UserName"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                           placeholder="Chọn tên đăng nhập"
                           pattern="^[a-zA-Z0-9_]+$"
                           minlength="3"
                           maxlength="20"
                           title="Tên đăng nhập chỉ được chứa chữ cái, số và dấu gạch dưới"
                           required />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Chỉ được sử dụng chữ cái, số và dấu gạch dưới (_)</p>
                    <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>
                    <span id="userNameError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-5">
                    <label for="Email" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-envelope mr-2"></i>Email
                    </label>
                    <input type="email" 
                           id="Email" 
                           name="Email"
                           asp-for="Email"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                           placeholder="Nhập địa chỉ email"
                           required />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    <span id="emailError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-5">
                    <label for="FullName" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-id-card mr-2"></i>Họ và tên
                    </label>
                    <input type="text" 
                           id="FullName" 
                           name="FullName"
                           asp-for="FullName"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                           placeholder="Nhập họ và tên đầy đủ" />
                    <span asp-validation-for="FullName" class="text-red-500 text-sm"></span>
                    <span id="fullNameError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-5">
                    <label for="password" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-lock mr-2"></i>Mật khẩu
                    </label>
                    <div class="relative">
                        <input type="password" 
                               id="password" 
                               name="password" 
                               class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                               placeholder="Chọn mật khẩu mạnh"
                               required 
                               minlength="8" />
                        <button type="button" 
                                onclick="togglePassword('password', 'toggleIcon1')" 
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                            <i class="fas fa-eye" id="toggleIcon1"></i>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt</p>
                    <span id="passwordError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label for="confirmPassword" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-lock mr-2"></i>Xác nhận mật khẩu
                    </label>
                    <div class="relative">
                        <input type="password" 
                               id="confirmPassword" 
                               name="confirmPassword" 
                               class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                               placeholder="Xác nhận mật khẩu"
                               required />
                        <button type="button" 
                                onclick="togglePassword('confirmPassword', 'toggleIcon2')" 
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                            <i class="fas fa-eye" id="toggleIcon2"></i>
                        </button>
                    </div>
                    <span id="confirmPasswordError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label class="flex items-start">
                        <input type="checkbox" id="terms" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary mt-1" required>
                        <span class="ml-2 text-gray-600 dark:text-gray-400 text-sm">
                            Tôi đồng ý với <a href="#" class="text-primary hover:text-pink-600">Điều khoản và Điều kiện</a> và <a href="#" class="text-primary hover:text-pink-600">Chính sách bảo mật</a>
                        </span>
                    </label>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg mb-4">
                        <div class="flex items-start">
                            <i class="fas fa-exclamation-circle mr-2 mt-1"></i>
                            <div class="flex-1">
                                <p class="font-semibold mb-1">Có lỗi xảy ra:</p>
                                <div asp-validation-summary="ModelOnly" class="text-sm"></div>
                            </div>
                        </div>
                    </div>
                }

                <div id="errorMessage" class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg mb-4 hidden">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span id="errorText"></span>
                </div>

                <button type="submit" 
                        class="w-full bg-gradient-to-r from-primary to-secondary text-white font-semibold py-3 rounded-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 relative overflow-hidden group">
                    <span class="relative z-10 flex items-center justify-center">
                        <i class="fas fa-user-plus mr-2 group-hover:animate-bounce"></i>Tạo tài khoản
                    </span>
                    <span class="absolute inset-0 bg-gradient-to-r from-secondary to-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                </button>
            </form>

            <!-- Divider -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-300 dark:border-gray-600"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400">Hoặc</span>
                </div>
            </div>

            <!-- Google Login Button -->
            <a asp-controller="Auth" asp-action="GoogleLogin"  
               class="w-full bg-white dark:bg-gray-700 border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 font-semibold py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-3 shadow-md hover:shadow-lg">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <span>Đăng nhập bằng Google</span>
            </a>

            <div class="mt-6 text-center">
                <p class="text-gray-600 dark:text-gray-400">
                    Đã có tài khoản?
                    <a asp-controller="Auth" asp-action="Login" class="text-primary hover:text-pink-600 font-semibold">
                        Đăng nhập tại đây
                    </a>
                </p>
            </div>
        </div>

        <div class="mt-8 text-center">
            <p class="text-gray-500 dark:text-gray-400 text-sm">
                <i class="fas fa-shield-alt mr-1"></i>
                Thông tin của bạn được bảo mật tuyệt đối
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Toggle password visibility
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const toggleIcon = document.getElementById(iconId);
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Global variables
        const registerForm = document.getElementById('registerForm');
        const submitBtn = registerForm.querySelector('button[type="submit"]');
        const errorBox = document.getElementById('errorMessage');
        const errorText = document.getElementById('errorText');

        // Password strength validation
        function passwordStrengthIssues(pw) {
            const issues = [];
            if (pw.length < 8) {
                issues.push('Mật khẩu phải có ít nhất 8 ký tự');
            }
            if (!/[a-z]/.test(pw)) {
                issues.push('Phải có ít nhất 1 chữ thường');
            }
            if (!/[A-Z]/.test(pw)) {
                issues.push('Phải có ít nhất 1 chữ hoa');
            }
            if (!/[0-9]/.test(pw)) {
                issues.push('Phải có ít nhất 1 chữ số');
            }
            if (!/[!@@#$%^&*()_+\-=[\]{};':"\\|,.<>\/?`~]/.test(pw)) {
                issues.push('Phải có ít nhất 1 ký tự đặc biệt');
            }
            return issues;
        }

        // Validate username
        function validateUsername(showMessages = false) {
            const userNameInput = document.getElementById('UserName');
            const userNameOriginal = userNameInput.value;
            const userName = userNameOriginal.trim();
            const userNameError = document.getElementById('userNameError');
            const userNamePattern = /^[a-zA-Z0-9_]+$/;
            let isValid = true;
            let errorMsg = '';

            // Kiểm tra rỗng
            if (!userName || userName.length === 0) {
                if (showMessages) {
                    errorMsg = 'Tên đăng nhập không được để trống.';
                    isValid = false;
                }
            }
            // Kiểm tra dấu cách trong giá trị gốc
            else if (/\s/.test(userNameOriginal)) {
                errorMsg = 'Tên đăng nhập không được chứa dấu cách.';
                isValid = false;
            }
            // Kiểm tra pattern
            else if (!userNamePattern.test(userName)) {
                errorMsg = 'Tên đăng nhập chỉ được chứa chữ cái, số và gạch dưới (_).';
                isValid = false;
            }
            // Kiểm tra độ dài
            else if (userName.length < 3 || userName.length > 20) {
                errorMsg = 'Tên đăng nhập phải từ 3 đến 20 ký tự.';
                isValid = false;
            }

            if (errorMsg) {
                userNameError.textContent = errorMsg;
                userNameInput.classList.add('border-red-500');
            } else {
                userNameError.textContent = '';
                userNameInput.classList.remove('border-red-500');
            }

            return { isValid, errorMsg };
        }

        // Validate email
        function validateEmail(showMessages = false) {
            const emailInput = document.getElementById('Email');
            const emailOriginal = emailInput.value;
            const emailVal = emailOriginal.trim();
            const emailError = document.getElementById('emailError');
            const emailErrorSpan = emailInput.closest('div').querySelector('span[asp-validation-for="Email"]');
            let isValid = true;
            let errorMsg = '';

            // Kiểm tra rỗng
            if (!emailVal || emailVal.length === 0) {
                if (showMessages) {
                    errorMsg = 'Email không được để trống.';
                    isValid = false;
                }
            }
            // Kiểm tra dấu cách trong giá trị gốc
            else if (/\s/.test(emailOriginal)) {
                errorMsg = 'Email không được chứa dấu cách.';
                isValid = false;
            }
            // Kiểm tra format email
            else {
                // Email regex: chấp nhận hầu hết các định dạng email hợp lệ
                // Không cho phép dấu cách (đã kiểm tra ở trên)
                const emailRegex = /^[a-zA-Z0-9](?:[a-zA-Z0-9._-]*[a-zA-Z0-9])?@@[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?\.[a-zA-Z]{2,}$/;
                if (!emailRegex.test(emailVal)) {
                    errorMsg = 'Email không hợp lệ. Vui lòng nhập đúng định dạng email (ví dụ: example@domain.com).';
                    isValid = false;
                }
            }

            if (errorMsg) {
                emailError.textContent = errorMsg;
                if (emailErrorSpan) emailErrorSpan.textContent = '';
                emailInput.classList.add('border-red-500');
            } else {
                emailError.textContent = '';
                if (emailErrorSpan) emailErrorSpan.textContent = '';
                emailInput.classList.remove('border-red-500');
            }

            return { isValid, errorMsg };
        }

        // Validate full name
        function validateFullName(showMessages = false) {
            const fullNameInput = document.getElementById('FullName');
            const fullName = fullNameInput.value.trim();
            const fullNameError = document.getElementById('fullNameError');
            let isValid = true;
            let errorMsg = '';

            // FullName là optional, nhưng nếu có thì validate
            if (fullName.length > 0) {
                if (fullName.length < 2) {
                    errorMsg = 'Họ và tên phải có ít nhất 2 ký tự.';
                    isValid = false;
                } else if (fullName.length > 100) {
                    errorMsg = 'Họ và tên không được vượt quá 100 ký tự.';
                    isValid = false;
                } else if (!/^[a-zA-ZÀ-ỹ\s]+$/.test(fullName)) {
                    errorMsg = 'Họ và tên chỉ được chứa chữ cái và dấu cách.';
                    isValid = false;
                }
            }

            if (errorMsg) {
                fullNameError.textContent = errorMsg;
                fullNameInput.classList.add('border-red-500');
            } else {
                fullNameError.textContent = '';
                fullNameInput.classList.remove('border-red-500');
            }

            return { isValid, errorMsg };
        }

        // Validate password
        function validatePassword(showMessages = false) {
            const passwordInput = document.getElementById('password');
            const password = passwordInput.value;
            const passwordError = document.getElementById('passwordError');
            let isValid = true;
            let errorMsg = '';

            if (!password || password.length === 0) {
                if (showMessages) {
                    errorMsg = 'Mật khẩu không được để trống.';
                    isValid = false;
                }
            } else {
                const pwIssues = passwordStrengthIssues(password);
                if (pwIssues.length > 0) {
                    errorMsg = pwIssues[0];
                    isValid = false;
                }
            }

            if (errorMsg) {
                passwordError.textContent = errorMsg;
                passwordInput.classList.add('border-red-500');
            } else {
                passwordError.textContent = '';
                passwordInput.classList.remove('border-red-500');
            }

            return { isValid, errorMsg, issues: passwordStrengthIssues(password) };
        }

        // Validate confirm password
        function validateConfirmPassword(showMessages = false) {
            const passwordInput = document.getElementById('password');
            const confirmInput = document.getElementById('confirmPassword');
            const password = passwordInput.value;
            const confirmPassword = confirmInput.value;
            const confirmError = document.getElementById('confirmPasswordError');
            let isValid = true;
            let errorMsg = '';

            if (!confirmPassword || confirmPassword.length === 0) {
                if (showMessages) {
                    errorMsg = 'Vui lòng xác nhận mật khẩu.';
                    isValid = false;
                }
            } else if (password !== confirmPassword) {
                errorMsg = 'Mật khẩu xác nhận không khớp.';
                isValid = false;
            }

            if (errorMsg) {
                confirmError.textContent = errorMsg;
                confirmInput.classList.add('border-red-500');
            } else {
                confirmError.textContent = '';
                confirmInput.classList.remove('border-red-500');
            }

            return { isValid, errorMsg };
        }

        // Validate terms
        function validateTerms(showMessages = false) {
            const terms = document.getElementById('terms');
            let isValid = terms.checked;
            let errorMsg = '';

            if (!isValid && showMessages) {
                errorMsg = 'Bạn phải đồng ý với Điều khoản và Chính sách.';
            }

            return { isValid, errorMsg };
        }

        // Main validation function
        function validateForm(showMessages = false) {
            const usernameResult = validateUsername(showMessages);
            const emailResult = validateEmail(showMessages);
            const fullNameResult = validateFullName(showMessages);
            const passwordResult = validatePassword(showMessages);
            const confirmPasswordResult = validateConfirmPassword(showMessages);
            const termsResult = validateTerms(showMessages);

            const isValid = usernameResult.isValid && 
                          emailResult.isValid && 
                          fullNameResult.isValid && 
                          passwordResult.isValid && 
                          confirmPasswordResult.isValid && 
                          termsResult.isValid;

            const errors = [];
            if (!usernameResult.isValid && usernameResult.errorMsg) errors.push(usernameResult.errorMsg);
            if (!emailResult.isValid && emailResult.errorMsg) errors.push(emailResult.errorMsg);
            if (!fullNameResult.isValid && fullNameResult.errorMsg) errors.push(fullNameResult.errorMsg);
            if (!passwordResult.isValid && passwordResult.errorMsg) {
                if (passwordResult.issues) {
                    errors.push(...passwordResult.issues);
                } else {
                    errors.push(passwordResult.errorMsg);
                }
            }
            if (!confirmPasswordResult.isValid && confirmPasswordResult.errorMsg) errors.push(confirmPasswordResult.errorMsg);
            if (!termsResult.isValid && termsResult.errorMsg) errors.push(termsResult.errorMsg);

            // Error box handling
            if (showMessages && errors.length > 0) {
                errorText.innerHTML = errors.map(e => `• ${e}`).join('<br>');
                errorBox.classList.remove('hidden');
            } else {
                errorText.textContent = '';
                errorBox.classList.add('hidden');
            }

            // Update submit button
            submitBtn.disabled = !isValid;
            submitBtn.classList.toggle('opacity-50', !isValid);
            submitBtn.classList.toggle('cursor-not-allowed', !isValid);

            return isValid;
        }

        // ========== Event Listeners ==========

        // Form submit validation
        registerForm.addEventListener('submit', function(e) {
            if (!validateForm(true)) {
                e.preventDefault();
            }
        });

        // ========== Username Validation ==========
        const userNameInput = document.getElementById('UserName');
        
        // Chặn dấu cách khi nhập (keypress)
        userNameInput.addEventListener('keypress', function(e) {
            if (e.key === ' ' || e.keyCode === 32) {
                e.preventDefault();
                const userNameError = document.getElementById('userNameError');
                userNameError.textContent = 'Dấu cách không được phép trong tên đăng nhập.';
                this.classList.add('border-red-500');
                setTimeout(() => {
                    if (this.value && !/\s/.test(this.value)) {
                        validateForm(false);
                    }
                }, 2000);
            }
        });

        // Xử lý paste và validate real-time
        userNameInput.addEventListener('input', function() {
            const originalValue = this.value;
            const newValue = originalValue.replace(/\s/g, '');
            
            if (originalValue !== newValue) {
                this.value = newValue;
                const userNameError = document.getElementById('userNameError');
                userNameError.textContent = 'Dấu cách không được phép trong tên đăng nhập.';
                this.classList.add('border-red-500');
                setTimeout(() => {
                    if (this.value === newValue) {
                        validateForm(false);
                    }
                }, 2000);
            } else {
                validateForm(false);
            }
        });

        // ========== Email Validation ==========
        const emailInput = document.getElementById('Email');
        
        // Chặn dấu cách khi nhập (keypress)
        emailInput.addEventListener('keypress', function(e) {
            if (e.key === ' ' || e.keyCode === 32) {
                e.preventDefault();
                const emailError = document.getElementById('emailError');
                emailError.textContent = 'Email không được chứa dấu cách.';
                this.classList.add('border-red-500');
                setTimeout(() => {
                    if (this.value && !/\s/.test(this.value)) {
                        validateForm(false);
                    }
                }, 2000);
            }
        });

        // Xử lý paste và validate real-time
        emailInput.addEventListener('input', function() {
            const originalValue = this.value;
            const newValue = originalValue.replace(/\s/g, '');
            
            if (originalValue !== newValue) {
                this.value = newValue;
                const emailError = document.getElementById('emailError');
                emailError.textContent = 'Email không được chứa dấu cách.';
                this.classList.add('border-red-500');
                setTimeout(() => {
                    if (this.value === newValue) {
                        validateForm(false);
                    }
                }, 2000);
            } else {
                validateForm(false);
            }
        });

        // ========== FullName Validation ==========
        const fullNameInput = document.getElementById('FullName');
        fullNameInput.addEventListener('input', function() {
            validateForm(false);
        });

        // ========== Password Validation ==========
        const passwordInput = document.getElementById('password');
        passwordInput.addEventListener('input', function() {
            validateForm(false);
            // Validate confirm password khi password thay đổi
            validateConfirmPassword(false);
        });

        // ========== Confirm Password Validation ==========
        const confirmPasswordInput = document.getElementById('confirmPassword');
        confirmPasswordInput.addEventListener('input', function() {
            validateForm(false);
        });

        // ========== Terms Validation ==========
        const termsInput = document.getElementById('terms');
        termsInput.addEventListener('change', function() {
            validateForm(false);
        });

        // Initial validation
        validateForm(false);
    </script>
}
