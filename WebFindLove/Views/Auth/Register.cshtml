@model WebFindLove.Models.User

@{
    ViewData["Title"] = "Đăng ký";
}

<div class="min-h-[80vh] flex items-center justify-center py-12">
    <div class="max-w-md w-full">
        <div class="text-center mb-8">
            <i class="fas fa-heart text-6xl text-primary mb-4"></i>
            <h2 class="text-3xl font-bold text-gray-800 dark:text-gray-100">Tham gia WebFindLove</h2>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Tạo tài khoản và bắt đầu hành trình của bạn</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-8">
            <form method="post" asp-action="Register" asp-controller="Auth" id="registerForm">
                @Html.AntiForgeryToken()
                
                <div class="mb-5">
                    <label for="UserName" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-user mr-2"></i>Tên đăng nhập
                    </label>
                    <input type="text" 
                           id="UserName" 
                           name="UserName"
                           asp-for="UserName"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                           placeholder="Chọn tên đăng nhập"
                           pattern="^[a-zA-Z0-9_]+$"
                           minlength="3"
                           maxlength="20"
                           title="Tên đăng nhập chỉ được chứa chữ cái, số và dấu gạch dưới"
                           required />
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Chỉ được sử dụng chữ cái, số và dấu gạch dưới (_)</p>
                    <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>
                    <span id="userNameError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-5">
                    <label for="Email" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-envelope mr-2"></i>Email
                    </label>
                    <input type="email" 
                           id="Email" 
                           name="Email"
                           asp-for="Email"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                           placeholder="Nhập địa chỉ email"
                           required />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-5">
                    <label for="FullName" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-id-card mr-2"></i>Họ và tên
                    </label>
                    <input type="text" 
                           id="FullName" 
                           name="FullName"
                           asp-for="FullName"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                           placeholder="Nhập họ và tên đầy đủ" />
                    <span asp-validation-for="FullName" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-5">
                    <label for="password" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-lock mr-2"></i>Mật khẩu
                    </label>
                    <div class="relative">
                        <input type="password" 
                               id="password" 
                               name="password" 
                               class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                               placeholder="Chọn mật khẩu mạnh"
                               required 
                               minlength="8" />
                        <button type="button" 
                                onclick="togglePassword('password', 'toggleIcon1')" 
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                            <i class="fas fa-eye" id="toggleIcon1"></i>
                        </button>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Phải có ít nhất 6 ký tự</p>
                    <span id="passwordError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label for="confirmPassword" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-lock mr-2"></i>Xác nhận mật khẩu
                    </label>
                    <div class="relative">
                        <input type="password" 
                               id="confirmPassword" 
                               name="confirmPassword" 
                               class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
                               placeholder="Xác nhận mật khẩu"
                               required />
                        <button type="button" 
                                onclick="togglePassword('confirmPassword', 'toggleIcon2')" 
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
                            <i class="fas fa-eye" id="toggleIcon2"></i>
                        </button>
                    </div>
                    <span id="confirmPasswordError" class="text-red-500 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label class="flex items-start">
                        <input type="checkbox" id="terms" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary mt-1" required>
                        <span class="ml-2 text-gray-600 dark:text-gray-400 text-sm">
                            Tôi đồng ý với <a href="#" class="text-primary hover:text-pink-600">Điều khoản và Điều kiện</a> và <a href="#" class="text-primary hover:text-pink-600">Chính sách bảo mật</a>
                        </span>
                    </label>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg mb-4">
                        <div class="flex items-start">
                            <i class="fas fa-exclamation-circle mr-2 mt-1"></i>
                            <div class="flex-1">
                                <p class="font-semibold mb-1">Có lỗi xảy ra:</p>
                                <div asp-validation-summary="ModelOnly" class="text-sm"></div>
                            </div>
                        </div>
                    </div>
                }

                <div id="errorMessage" class="bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg mb-4 hidden">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span id="errorText"></span>
                </div>

                <button type="submit" 
                        class="w-full bg-gradient-to-r from-primary to-secondary text-white font-semibold py-3 rounded-lg hover:shadow-lg transition duration-300 transform hover:scale-105">
                    <i class="fas fa-user-plus mr-2"></i>Tạo tài khoản
                </button>
            </form>

            <!-- Divider -->
            <div class="relative my-6">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-300 dark:border-gray-600"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-2 bg-white dark:bg-gray-800 text-gray-500 dark:text-gray-400">Hoặc</span>
                </div>
            </div>

            <!-- Google Login Button -->
            <a asp-controller="Auth" asp-action="GoogleLogin"  
               class="w-full bg-white dark:bg-gray-700 border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 font-semibold py-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-600 transition duration-300 flex items-center justify-center gap-3">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
                <span>Đăng nhập bằng Google</span>
            </a>

            <div class="mt-6 text-center">
                <p class="text-gray-600 dark:text-gray-400">
                    Đã có tài khoản?
                    <a asp-controller="Auth" asp-action="Login" class="text-primary hover:text-pink-600 font-semibold">
                        Đăng nhập tại đây
                    </a>
                </p>
            </div>
        </div>

        <div class="mt-8 text-center">
            <p class="text-gray-500 dark:text-gray-400 text-sm">
                <i class="fas fa-shield-alt mr-1"></i>
                Thông tin của bạn được bảo mật tuyệt đối
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePassword(inputId, iconId) {
            const passwordInput = document.getElementById(inputId);
            const toggleIcon = document.getElementById(iconId);
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Client-side validation helpers
        const registerForm = document.getElementById('registerForm');
        const submitBtn = registerForm.querySelector('button[type="submit"]');
        const errorBox = document.getElementById('errorMessage');
        const errorText = document.getElementById('errorText');

        function passwordStrengthIssues(pw) {
            const issues = [];
            if (pw.length < 8) issues.push('Mật khẩu phải có ít nhất 8 ký tự');
            if (!/[a-z]/.test(pw)) issues.push('Phải có ít nhất 1 chữ thường');
            if (!/[A-Z]/.test(pw)) issues.push('Phải có ít nhất 1 chữ hoa');
            if (!/[0-9]/.test(pw)) issues.push('Phải có ít nhất 1 chữ số');
            if (!/[!@@#$%^&*()_+\-=[\]{};':"\\|,.<>\/?`~]/.test(pw)) issues.push('Phải có ít nhất 1 ký tự đặc biệt');
            return issues;
        }

        function validateForm(showMessages = false) {
            let valid = true;
            const errors = [];

            // Username
            const userNameInput = document.getElementById('UserName');
            const userName = userNameInput.value.trim();
            const userNameError = document.getElementById('userNameError');
            const userNamePattern = /^[a-zA-Z0-9_]+$/;
            if (!userNamePattern.test(userName)) {
                valid = false;
                const msg = 'Tên đăng nhập chỉ chứa chữ cái, số và gạch dưới (_).';
                userNameError.textContent = msg;
                userNameInput.classList.add('border-red-500');
                if (showMessages) errors.push(msg);
            } else if (userName.length < 3 || userName.length > 20) {
                valid = false;
                const msg = 'Tên đăng nhập phải từ 3 đến 20 ký tự.';
                userNameError.textContent = msg;
                userNameInput.classList.add('border-red-500');
                if (showMessages) errors.push(msg);
            } else {
                userNameError.textContent = '';
                userNameInput.classList.remove('border-red-500');
            }

            // Email
            const emailInput = document.getElementById('Email');
            const emailVal = emailInput.value.trim();
            const emailErrorSpan = emailInput.closest('div').querySelector('span[asp-validation-for="Email"]');
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/;
            if (!emailRegex.test(emailVal)) {
                valid = false;
                const msg = 'Email không hợp lệ.';
                if (emailErrorSpan) emailErrorSpan.textContent = msg;
                emailInput.classList.add('border-red-500');
                if (showMessages) errors.push(msg);
            } else {
                if (emailErrorSpan) emailErrorSpan.textContent = '';
                emailInput.classList.remove('border-red-500');
            }

            // Password
            const passwordInput = document.getElementById('password');
            const password = passwordInput.value;
            const pwIssues = passwordStrengthIssues(password);
            const passwordError = document.getElementById('passwordError');
            if (pwIssues.length) {
                valid = false;
                const msg = pwIssues[0];
                passwordError.textContent = msg;
                passwordInput.classList.add('border-red-500');
                if (showMessages) errors.push(...pwIssues);
            } else {
                passwordError.textContent = '';
                passwordInput.classList.remove('border-red-500');
            }

            // Confirm password
            const confirmInput = document.getElementById('confirmPassword');
            const confirmError = document.getElementById('confirmPasswordError');
            if (password !== confirmInput.value) {
                valid = false;
                const msg = 'Mật khẩu không khớp';
                confirmError.textContent = msg;
                confirmInput.classList.add('border-red-500');
                if (showMessages) errors.push(msg);
            } else {
                confirmError.textContent = '';
                confirmInput.classList.remove('border-red-500');
            }

            // Terms
            const terms = document.getElementById('terms');
            if (!terms.checked) {
                valid = false;
                if (showMessages) errors.push('Bạn phải đồng ý Điều khoản và Chính sách.');
            }

            // Error box handling
            if (showMessages && errors.length) {
                errorText.innerHTML = errors.map(e => `• ${e}`).join('<br>');
                errorBox.classList.remove('hidden');
            } else if (errors.length === 0) {
                errorText.textContent = '';
                errorBox.classList.add('hidden');
            }

            submitBtn.disabled = !valid;
            submitBtn.classList.toggle('opacity-50', !valid);
            submitBtn.classList.toggle('cursor-not-allowed', !valid);
            return valid;
        }

        // Validate on submit
        registerForm.addEventListener('submit', function(e) {
            if (!validateForm(true)) {
                e.preventDefault();
            }
        });

        // Live validation
        ['UserName','Email','password','confirmPassword','terms'].forEach(id => {
            const el = document.getElementById(id);
            const evt = id === 'terms' ? 'change' : 'input';
            el.addEventListener(evt, () => validateForm(false));
        });

        // Initial state
        validateForm(false);

        // Clear error on input
        document.getElementById('UserName').addEventListener('input', function() {
            document.getElementById('userNameError').textContent = '';
            this.classList.remove('border-red-500');
        });

        document.getElementById('confirmPassword').addEventListener('input', function() {
            document.getElementById('confirmPasswordError').textContent = '';
            this.classList.remove('border-red-500');
        });

        document.getElementById('password').addEventListener('input', function() {
            document.getElementById('passwordError').textContent = '';
            this.classList.remove('border-red-500');
        });
    </script>
}
