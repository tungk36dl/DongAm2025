@model WebFindLove.Models.PersonalityTrait
@{
    ViewData["Title"] = "Chỉnh Sửa Tính Cách";
}

<div class="container mx-auto px-4 py-8 max-w-3xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-purple-600 hover:text-purple-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Quay Lại Tính Cách
        </a>
        <h1 class="text-3xl font-bold text-gray-800 mb-2">
            <i class="fas fa-brain text-purple-600 mr-2"></i>Chỉnh Sửa Tính Cách
        </h1>
        <p class="text-gray-600">Thêm hoặc cập nhật thông tin tính cách của bạn</p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div class="space-y-6">
                <!-- MBTI Type -->
                <div>
                    <label asp-for="MbtiType" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-id-card text-purple-500 mr-1"></i>
                        Nhóm MBTI
                    </label>
                    <select asp-for="MbtiType" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                        <option value="">Chọn nhóm MBTI của bạn</option>
                        <optgroup label="Nhà Phân Tích">
                            <option value="INTJ">INTJ - Kiến Trúc Sư</option>
                            <option value="INTP">INTP - Nhà Logic</option>
                            <option value="ENTJ">ENTJ - Chỉ Huy</option>
                            <option value="ENTP">ENTP - Nhà Tranh Luận</option>
                        </optgroup>
                        <optgroup label="Nhà Ngoại Giao">
                            <option value="INFJ">INFJ - Người Ủng Hộ</option>
                            <option value="INFP">INFP - Nhà Hòa Giải</option>
                            <option value="ENFJ">ENFJ - Người Chủ Đạo</option>
                            <option value="ENFP">ENFP - Người Vận Động</option>
                        </optgroup>
                        <optgroup label="Người Bảo Vệ">
                            <option value="ISTJ">ISTJ - Nhà Hậu Cần</option>
                            <option value="ISFJ">ISFJ - Người Bảo Vệ</option>
                            <option value="ESTJ">ESTJ - Giám Đốc</option>
                            <option value="ESFJ">ESFJ - Lãnh Sự</option>
                        </optgroup>
                        <optgroup label="Nhà Thám Hiểm">
                            <option value="ISTP">ISTP - Nhà Kỹ Thuật</option>
                            <option value="ISFP">ISFP - Nhà Phiêu Lưu</option>
                            <option value="ESTP">ESTP - Doanh Nhân</option>
                            <option value="ESFP">ESFP - Nghệ Sĩ</option>
                        </optgroup>
                    </select>
                    <span asp-validation-for="MbtiType" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Chưa biết nhóm của bạn? 
                        <a href="https://www.16personalities.com/free-personality-test" target="_blank" class="text-purple-600 hover:underline">
                            Làm bài test <i class="fas fa-external-link-alt text-xs"></i>
                        </a>
                    </p>
                </div>

                <!-- Traits JSON -->
                <div>
                    <label asp-for="TraitsJson" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-list-ul text-blue-500 mr-1"></i>
                        Đặc Điểm Tính Cách (JSON)
                    </label>
                    <textarea asp-for="TraitsJson" rows="6"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='{
  "openness": 85,
  "conscientiousness": 70,
  "extraversion": 60,
  "agreeableness": 75,
  "neuroticism": 40
}'></textarea>
                    <span asp-validation-for="TraitsJson" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Định dạng JSON: 5 đặc điểm với điểm số 0-100
                    </p>
                </div>

                <!-- AI Summary -->
                <div>
                    <label asp-for="AiSummary" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-robot text-green-500 mr-1"></i>
                        Tổng Kết Tính Cách Từ AI
                    </label>
                    <textarea asp-for="AiSummary" rows="4"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                              placeholder="Ví dụ: Bạn là người có tư duy sáng tạo và phân tích, coi trọng sự độc lập và đam mê trí tuệ. Bạn thích làm việc một mình hoặc trong nhóm nhỏ và xuất sắc trong việc lập kế hoạch chiến lược."></textarea>
                    <span asp-validation-for="AiSummary" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Tùy chọn: Mô tả ngắn gọn về tính cách của bạn
                    </p>
                </div>

                <!-- Compatibility Weight -->
                <div>
                    <label asp-for="CompatibilityWeight" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-weight text-orange-500 mr-1"></i>
                        Trọng Số Tương Thích (JSON)
                    </label>
                    <textarea asp-for="CompatibilityWeight" rows="4"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='{
  "personality": 0.4,
  "interests": 0.3,
  "values": 0.2,
  "lifestyle": 0.1
}'></textarea>
                    <span asp-validation-for="CompatibilityWeight" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Tùy chọn: Trọng số cho các tiêu chí ghép đôi (tổng phải bằng 1.0)
                    </p>
                </div>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex gap-3">
                <button type="submit" 
                        class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Lưu Tính Cách
                </button>
                <a asp-action="Index" 
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition">
                    Hủy
                </a>
            </div>
        </form>
    </div>

    <!-- Help Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
        <!-- Big Five Example -->
        <div class="bg-blue-50 border-l-4 border-blue-500 rounded-lg p-4">
            <h3 class="font-semibold text-blue-800 mb-2 flex items-center gap-2">
                <i class="fas fa-lightbulb"></i>
                5 Đặc Điểm Lớn
            </h3>
            <ul class="text-blue-700 text-sm space-y-1">
                <li><strong>Cởi Mở:</strong> Sáng tạo, tò mò (0-100)</li>
                <li><strong>Tận Tâm:</strong> Tổ chức, trách nhiệm</li>
                <li><strong>Hướng Ngoại:</strong> Giao tiếp, năng lượng</li>
                <li><strong>Hoà Đồng:</strong> Tử tế, hợp tác</li>
                <li><strong>Bất Ổn Cảm Xúc:</strong> Ổn định cảm xúc</li>
            </ul>
        </div>

        <!-- AI Matching -->
        <div class="bg-purple-50 border-l-4 border-purple-500 rounded-lg p-4">
            <h3 class="font-semibold text-purple-800 mb-2 flex items-center gap-2">
                <i class="fas fa-magic"></i>
                Ghép Đôi AI
            </h3>
            <p class="text-purple-700 text-sm">
                AI của chúng tôi sử dụng dữ liệu tính cách để tính điểm tương thích và tìm người phù hợp nhất. Thông tin càng chi tiết = kết quả càng tốt!
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

