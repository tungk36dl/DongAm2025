@model WebFindLove.Models.PersonalityTrait
@{
    ViewData["Title"] = "Edit Personality";
}

<div class="container mx-auto px-4 py-8 max-w-3xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-purple-600 hover:text-purple-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Back to Personality
        </a>
        <h1 class="text-3xl font-bold text-gray-800 mb-2">
            <i class="fas fa-brain text-purple-600 mr-2"></i>Edit My Personality
        </h1>
        <p class="text-gray-600">Add or update your personality information</p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div class="space-y-6">
                <!-- MBTI Type -->
                <div>
                    <label asp-for="MbtiType" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-id-card text-purple-500 mr-1"></i>
                        MBTI Type
                    </label>
                    <select asp-for="MbtiType" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                        <option value="">Select your MBTI type</option>
                        <optgroup label="Analysts">
                            <option value="INTJ">INTJ - Architect</option>
                            <option value="INTP">INTP - Logician</option>
                            <option value="ENTJ">ENTJ - Commander</option>
                            <option value="ENTP">ENTP - Debater</option>
                        </optgroup>
                        <optgroup label="Diplomats">
                            <option value="INFJ">INFJ - Advocate</option>
                            <option value="INFP">INFP - Mediator</option>
                            <option value="ENFJ">ENFJ - Protagonist</option>
                            <option value="ENFP">ENFP - Campaigner</option>
                        </optgroup>
                        <optgroup label="Sentinels">
                            <option value="ISTJ">ISTJ - Logistician</option>
                            <option value="ISFJ">ISFJ - Defender</option>
                            <option value="ESTJ">ESTJ - Executive</option>
                            <option value="ESFJ">ESFJ - Consul</option>
                        </optgroup>
                        <optgroup label="Explorers">
                            <option value="ISTP">ISTP - Virtuoso</option>
                            <option value="ISFP">ISFP - Adventurer</option>
                            <option value="ESTP">ESTP - Entrepreneur</option>
                            <option value="ESFP">ESFP - Entertainer</option>
                        </optgroup>
                    </select>
                    <span asp-validation-for="MbtiType" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Don't know your type? 
                        <a href="https://www.16personalities.com/free-personality-test" target="_blank" class="text-purple-600 hover:underline">
                            Take the test <i class="fas fa-external-link-alt text-xs"></i>
                        </a>
                    </p>
                </div>

                <!-- Traits JSON -->
                <div>
                    <label asp-for="TraitsJson" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-list-ul text-blue-500 mr-1"></i>
                        Personality Traits (JSON)
                    </label>
                    <textarea asp-for="TraitsJson" rows="6"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='{
  "openness": 85,
  "conscientiousness": 70,
  "extraversion": 60,
  "agreeableness": 75,
  "neuroticism": 40
}'></textarea>
                    <span asp-validation-for="TraitsJson" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        JSON format: Big Five traits with scores 0-100
                    </p>
                </div>

                <!-- AI Summary -->
                <div>
                    <label asp-for="AiSummary" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-robot text-green-500 mr-1"></i>
                        AI Personality Summary
                    </label>
                    <textarea asp-for="AiSummary" rows="4"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                              placeholder="e.g., You are an innovative and analytical thinker who values independence and intellectual pursuits. You prefer working alone or in small groups and excel at strategic planning."></textarea>
                    <span asp-validation-for="AiSummary" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Optional: A brief summary of your personality
                    </p>
                </div>

                <!-- Compatibility Weight -->
                <div>
                    <label asp-for="CompatibilityWeight" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-weight text-orange-500 mr-1"></i>
                        Compatibility Weights (JSON)
                    </label>
                    <textarea asp-for="CompatibilityWeight" rows="4"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='{
  "personality": 0.4,
  "interests": 0.3,
  "values": 0.2,
  "lifestyle": 0.1
}'></textarea>
                    <span asp-validation-for="CompatibilityWeight" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Optional: Weights for matching criteria (should sum to 1.0)
                    </p>
                </div>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex gap-3">
                <button type="submit" 
                        class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Save Personality
                </button>
                <a asp-action="Index" 
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition">
                    Cancel
                </a>
            </div>
        </form>
    </div>

    <!-- Help Sections -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
        <!-- Big Five Example -->
        <div class="bg-blue-50 border-l-4 border-blue-500 rounded-lg p-4">
            <h3 class="font-semibold text-blue-800 mb-2 flex items-center gap-2">
                <i class="fas fa-lightbulb"></i>
                Big Five Traits
            </h3>
            <ul class="text-blue-700 text-sm space-y-1">
                <li><strong>Openness:</strong> Creativity, curiosity (0-100)</li>
                <li><strong>Conscientiousness:</strong> Organization, responsibility</li>
                <li><strong>Extraversion:</strong> Sociability, energy</li>
                <li><strong>Agreeableness:</strong> Kindness, cooperation</li>
                <li><strong>Neuroticism:</strong> Emotional stability</li>
            </ul>
        </div>

        <!-- AI Matching -->
        <div class="bg-purple-50 border-l-4 border-purple-500 rounded-lg p-4">
            <h3 class="font-semibold text-purple-800 mb-2 flex items-center gap-2">
                <i class="fas fa-magic"></i>
                AI Matching
            </h3>
            <p class="text-purple-700 text-sm">
                Our AI uses your personality data to calculate compatibility scores and find your best matches. More detailed information = better matches!
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

