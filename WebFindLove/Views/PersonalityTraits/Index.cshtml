@model WebFindLove.Models.PersonalityTrait
@{
    ViewData["Title"] = "My Personality";
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">
            <i class="fas fa-brain text-purple-600 mr-2"></i>My Personality
        </h1>
        <p class="text-gray-600">Your personality traits and MBTI type</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Personality Display -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-lg shadow-md p-6">
                @if (Model.Id != Guid.Empty)
                {
                    <div class="space-y-6">
                        <!-- MBTI Type -->
                        @if (!string.IsNullOrEmpty(Model.MbtiType))
                        {
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center gap-2">
                                    <i class="fas fa-id-card text-purple-500"></i>
                                    MBTI Type
                                </h3>
                                <div class="bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg p-6 text-center text-white">
                                    <div class="text-5xl font-bold mb-2">@Model.MbtiType</div>
                                    <p class="text-purple-100">Myers-Briggs Type Indicator</p>
                                </div>
                            </div>
                        }

                        <!-- Traits JSON -->
                        @if (!string.IsNullOrEmpty(Model.TraitsJson))
                        {
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center gap-2">
                                    <i class="fas fa-list-ul text-blue-500"></i>
                                    Personality Traits
                                </h3>
                                <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                    <pre class="text-sm text-gray-700 overflow-x-auto">@Model.TraitsJson</pre>
                                </div>
                            </div>
                        }

                        <!-- AI Summary -->
                        @if (!string.IsNullOrEmpty(Model.AiSummary))
                        {
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center gap-2">
                                    <i class="fas fa-robot text-green-500"></i>
                                    AI Personality Summary
                                </h3>
                                <div class="bg-gradient-to-r from-blue-50 to-purple-50 p-4 rounded-lg border border-purple-200">
                                    <p class="text-gray-700 leading-relaxed">@Model.AiSummary</p>
                                </div>
                            </div>
                        }

                        <!-- Compatibility Weight -->
                        @if (!string.IsNullOrEmpty(Model.CompatibilityWeight))
                        {
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center gap-2">
                                    <i class="fas fa-weight text-orange-500"></i>
                                    Compatibility Weights
                                </h3>
                                <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
                                    <pre class="text-sm text-gray-700 overflow-x-auto">@Model.CompatibilityWeight</pre>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Edit Button -->
                    <div class="mt-6">
                        <a asp-action="Edit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg transition inline-block">
                            <i class="fas fa-edit mr-2"></i>Edit Personality
                        </a>
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="text-center py-8">
                        <i class="fas fa-brain text-gray-400 text-5xl mb-4"></i>
                        <h3 class="text-xl font-semibold text-gray-700 mb-2">No Personality Data</h3>
                        <p class="text-gray-500 mb-6">Add your personality information to improve match quality!</p>
                        <a asp-action="Edit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg transition inline-block">
                            <i class="fas fa-plus mr-2"></i>Add Personality
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Info Sidebar -->
        <div class="space-y-6">
            <!-- MBTI Info -->
            <div class="bg-purple-50 border-l-4 border-purple-500 rounded-lg p-4">
                <h3 class="font-semibold text-purple-800 mb-2 flex items-center gap-2">
                    <i class="fas fa-info-circle"></i>
                    About MBTI
                </h3>
                <p class="text-purple-700 text-sm mb-2">
                    The Myers-Briggs Type Indicator is a personality assessment tool with 16 types:
                </p>
                <div class="grid grid-cols-4 gap-1 text-xs font-mono text-purple-700">
                    <span>INTJ</span><span>INTP</span><span>ENTJ</span><span>ENTP</span>
                    <span>INFJ</span><span>INFP</span><span>ENFJ</span><span>ENFP</span>
                    <span>ISTJ</span><span>ISFJ</span><span>ESTJ</span><span>ESFJ</span>
                    <span>ISTP</span><span>ISFP</span><span>ESTP</span><span>ESFP</span>
                </div>
            </div>

            <!-- Big Five Traits -->
            <div class="bg-white rounded-lg shadow-md p-4">
                <h3 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
                    <i class="fas fa-list-ol text-blue-500"></i>
                    Big Five Traits
                </h3>
                <ul class="space-y-2 text-sm text-gray-600">
                    <li class="flex items-center gap-2">
                        <i class="fas fa-circle text-blue-500 text-xs"></i>
                        <span>Openness</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <i class="fas fa-circle text-green-500 text-xs"></i>
                        <span>Conscientiousness</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <i class="fas fa-circle text-yellow-500 text-xs"></i>
                        <span>Extraversion</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <i class="fas fa-circle text-purple-500 text-xs"></i>
                        <span>Agreeableness</span>
                    </li>
                    <li class="flex items-center gap-2">
                        <i class="fas fa-circle text-red-500 text-xs"></i>
                        <span>Neuroticism</span>
                    </li>
                </ul>
            </div>

            <!-- Quick Actions -->
            <div class="bg-white rounded-lg shadow-md p-4">
                <h3 class="font-semibold text-gray-800 mb-3">Quick Actions</h3>
                <div class="space-y-2">
                    <a asp-controller="MatchResults" asp-action="Index"
                       class="block bg-blue-600 hover:bg-blue-700 text-white text-center py-2 rounded-lg transition text-sm">
                        <i class="fas fa-heart mr-1"></i>View Matches
                    </a>
                    <a asp-controller="UserPreferences" asp-action="Index"
                       class="block bg-purple-600 hover:bg-purple-700 text-white text-center py-2 rounded-lg transition text-sm">
                        <i class="fas fa-sliders-h mr-1"></i>Preferences
                    </a>
                </div>
            </div>

            <!-- Take Test -->
            <div class="bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg shadow-md p-4 text-white">
                <h3 class="font-semibold mb-2 flex items-center gap-2">
                    <i class="fas fa-clipboard-check"></i>
                    Take MBTI Test
                </h3>
                <p class="text-purple-100 text-sm mb-3">
                    Not sure about your MBTI type? Take a free test online!
                </p>
                <a href="https://www.16personalities.com/free-personality-test" 
                   target="_blank"
                   class="block bg-white text-purple-600 text-center py-2 rounded-lg hover:bg-purple-50 transition text-sm font-medium">
                    Take Test
                    <i class="fas fa-external-link-alt ml-1 text-xs"></i>
                </a>
            </div>
        </div>
    </div>
</div>

