@model List<WebFindLove.Models.Entities.Conversation>
@{
    ViewData["Title"] = "Messages";
    var unreadCount = ViewData["UnreadCount"] as int? ?? 0;
    var currentUserIdString = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var currentUserId = Guid.TryParse(currentUserIdString, out var cuid) ? cuid : Guid.Empty;
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6 animate-fadeIn">
        <div>
            <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100 bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-500">
                <i class="fas fa-comments text-blue-500 mr-2 animate-pulse"></i>Messages
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">Your conversations</p>
            @if (unreadCount > 0)
            {
                <span class="inline-block mt-2 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-semibold animate-pulse shadow-lg">
                    @unreadCount unread message(s)
                </span>
            }
        </div>
    </div>

    <!-- Conversations List -->
    @if (Model != null && Model.Any())
    {
        <div class="bg-white/95 dark:bg-gray-800/95 backdrop-blur-md rounded-xl shadow-xl overflow-hidden border border-gray-200/50 dark:border-gray-700/50 animate-fadeIn">
            @foreach (var conversation in Model)
            {
                // Tìm người dùng khác trong conversation (không phải current user)
                var otherParticipant = conversation.Participants?.FirstOrDefault(p => p.UserId != currentUserId);
                var otherUser = otherParticipant?.User;
                var otherUserId = otherUser?.Id ?? Guid.Empty;
                var otherUserName = otherUser?.UserName ?? "Unknown User";
                var otherUserAvatar = otherUser?.Avatar;
                
                // Kiểm tra tin nhắn chưa đọc
                var hasUnread = conversation.Messages?.Any(m => !m.IsRead && m.ReceiverId == currentUserId) ?? false;
                DateTime tempTime = conversation.LastMessageAt ?? conversation.CreatedAt ?? DateTime.UtcNow;
                var lastMessageTime = tempTime.ToString("MMM dd, HH:mm");

                <a href="@Url.Action("Conversation", new { userId = otherUserId })" 
                   class="block border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-300 transform hover:scale-[1.01] @(hasUnread ? "bg-blue-50 dark:bg-blue-900/20" : "")">
                    <div class="p-6 flex items-start gap-4">
                        <!-- Avatar -->
                        <div class="flex-shrink-0">
                            @if (!string.IsNullOrEmpty(otherUserAvatar))
                            {
                                <img src="@otherUserAvatar" alt="@otherUserName" class="w-14 h-14 rounded-full object-cover border-2 border-gray-200">
                            }
                            else
                            {
                                <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-xl font-bold">
                                    @(otherUserName?.Substring(0, 1).ToUpper())
                                </div>
                            }
                        </div>

                        <!-- Message Info -->
                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start mb-1">
                                <h3 class="text-lg font-semibold text-gray-800 @(hasUnread ? "font-bold" : "")">
                                    @otherUserName
                                    @if (hasUnread)
                                    {
                                        <span class="ml-2 w-2 h-2 bg-red-500 rounded-full inline-block"></span>
                                    }
                                </h3>
                                <span class="text-sm text-gray-500">
                                    @lastMessageTime
                                </span>
                            </div>
                            
                            <p class="text-gray-600 truncate @(hasUnread ? "font-medium" : "")">
                                @if (!string.IsNullOrEmpty(conversation.LastMessage))
                                {
                                    @conversation.LastMessage
                                }
                                else
                                {
                                    <span class="text-gray-400 italic">No messages yet</span>
                                }
                            </p>
                        </div>

                        <!-- Arrow -->
                        <div class="flex-shrink-0">
                            <i class="fas fa-chevron-right text-gray-400"></i>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="bg-white/95 dark:bg-gray-800/95 backdrop-blur-md rounded-xl shadow-xl p-12 text-center border border-gray-200/50 dark:border-gray-700/50 animate-fadeIn">
            <i class="fas fa-comments text-gray-400 dark:text-gray-600 text-6xl mb-4 animate-pulse"></i>
            <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">No Messages Yet</h3>
            <p class="text-gray-500 dark:text-gray-400">Start a conversation with other users to see messages here.</p>
        </div>
    }
</div>

