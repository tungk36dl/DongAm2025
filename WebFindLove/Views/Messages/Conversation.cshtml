@model List<WebFindLove.Models.Message>
@{
    ViewData["Title"] = "Conversation";
    var otherUser = ViewData["OtherUser"] as WebFindLove.Models.Services.UserService.Dto.UserDto;
    var otherUserId = ViewData["OtherUserId"] as Guid?;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-4 mb-4 flex justify-between items-center">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="text-gray-600 hover:text-gray-800">
                <i class="fas fa-arrow-left text-xl"></i>
            </a>
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white text-lg font-bold">
                @(otherUser?.UserName?.Substring(0, 1).ToUpper())
            </div>
            <div>
                <h2 class="text-xl font-bold text-gray-800">@otherUser?.UserName</h2>
                <p class="text-sm text-gray-500">@otherUser?.Email</p>
            </div>
        </div>
    </div>

    <!-- Messages Container -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-4" style="height: 500px; overflow-y: auto;" id="messagesContainer">
        @if (Model != null && Model.Any())
        {
            @foreach (var message in Model)
            {
                var isSentByMe = message.SenderId.ToString() == currentUserId;
                var alignmentClass = isSentByMe ? "justify-end" : "justify-start";
                var bgClass = isSentByMe ? "bg-blue-600 text-white" : "bg-gray-200 text-gray-800";
                var roundingClass = isSentByMe ? "rounded-br-none" : "rounded-bl-none";

                <div class="flex @alignmentClass mb-4">
                    <div class="max-w-[70%]">
                        <div class="@bgClass @roundingClass rounded-2xl px-4 py-3 shadow">
                            <p class="break-words">@message.Content</p>
                        </div>
                        <div class="flex @(isSentByMe ? "justify-end" : "justify-start") gap-2 mt-1 px-2">
                            <span class="text-xs text-gray-500">
                                @message.SentAt.ToString("MMM dd, HH:mm")
                            </span>
                            @if (isSentByMe)
                            {
                                @if (message.IsRead)
                                {
                                    <span class="text-xs text-blue-600">
                                        <i class="fas fa-check-double"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">
                                        <i class="fas fa-check"></i>
                                    </span>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="flex items-center justify-center h-full">
                <div class="text-center text-gray-500">
                    <i class="fas fa-comments text-4xl mb-3"></i>
                    <p>No messages yet. Start the conversation!</p>
                </div>
            </div>
        }
    </div>

    <!-- Send Message Form -->
    <div class="bg-white rounded-lg shadow-md p-4">
        <form asp-action="Send" method="post" class="flex gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="receiverId" value="@otherUserId" />
            
            <input type="text" 
                   name="content" 
                   id="messageInput"
                   class="flex-1 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                   placeholder="Type your message..." 
                   required 
                   autocomplete="off">
            
            <button type="submit" 
                    class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                <i class="fas fa-paper-plane"></i>
                Send
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-scroll to bottom on page load
        const container = document.getElementById('messagesContainer');
        if (container) {
            container.scrollTop = container.scrollHeight;
        }

        // Focus on message input
        document.getElementById('messageInput')?.focus();
    </script>
}

