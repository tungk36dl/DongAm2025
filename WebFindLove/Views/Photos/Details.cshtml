@model WebFindLove.Models.Services.PhotoService.Dto.PhotoDto
@{
    ViewData["Title"] = "Photo Details";
}

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Back to Photos
        </a>
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-3xl font-bold text-gray-800">Photo Details</h1>
                <p class="text-gray-600 mt-1">View photo information</p>
            </div>
            <div class="flex gap-2">
                @if (!Model.IsPrimary)
                {
                    <form asp-action="SetPrimary" asp-route-id="@Model.Id" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" 
                                class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg transition">
                            <i class="fas fa-star mr-1"></i>Set as Primary
                        </button>
                    </form>
                }
                <a asp-action="Edit" asp-route-id="@Model.Id" 
                   class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">
                    <i class="fas fa-edit mr-1"></i>Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" 
                   class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition">
                    <i class="fas fa-trash mr-1"></i>Delete
                </a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Photo Display -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="relative">
                <img src="@Model.PhotoUrl" alt="Photo" 
                     class="w-full rounded-lg shadow-lg"
                     onerror="this.src='https://via.placeholder.com/500x500?text=Failed+to+load+image'">
                
                <!-- Badges -->
                <div class="absolute top-4 right-4 flex flex-col gap-2">
                    @if (Model.IsPrimary)
                    {
                        <span class="bg-yellow-500 text-white px-3 py-1 rounded-full text-sm font-semibold shadow-lg">
                            <i class="fas fa-star mr-1"></i>Primary
                        </span>
                    }
                    @if (Model.IsActive)
                    {
                        <span class="bg-green-500 text-white px-3 py-1 rounded-full text-sm font-semibold shadow-lg">
                            <i class="fas fa-check mr-1"></i>Active
                        </span>
                    }
                    else
                    {
                        <span class="bg-red-500 text-white px-3 py-1 rounded-full text-sm font-semibold shadow-lg">
                            <i class="fas fa-times mr-1"></i>Inactive
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Photo Information -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Information</h2>
            
            <div class="space-y-4">
                <!-- Photo ID -->
                <div>
                    <label class="block text-sm font-medium text-gray-500 mb-1">Photo ID</label>
                    <p class="text-gray-800 font-mono text-sm">@Model.Id</p>
                </div>

                <!-- User -->
                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-500 mb-1">Owner</label>
                        <p class="text-gray-800 flex items-center gap-2">
                            <i class="fas fa-user text-blue-600"></i>
                            @Model.UserName
                        </p>
                    </div>
                }

                <!-- Description -->
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-500 mb-1">Description</label>
                        <p class="text-gray-800">@Model.Description</p>
                    </div>
                }

                <!-- Photo URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-500 mb-1">Photo URL</label>
                    <p class="text-gray-800 break-all text-sm">
                        <a href="@Model.PhotoUrl" target="_blank" class="text-blue-600 hover:text-blue-800">
                            @Model.PhotoUrl
                            <i class="fas fa-external-link-alt ml-1 text-xs"></i>
                        </a>
                    </p>
                </div>

                <!-- Status -->
                <div>
                    <label class="block text-sm font-medium text-gray-500 mb-1">Status</label>
                    <div class="flex gap-4">
                        <div>
                            <span class="text-sm text-gray-600">Primary:</span>
                            <span class="ml-2">
                                @if (Model.IsPrimary)
                                {
                                    <i class="fas fa-check-circle text-green-600"></i>
                                    <span class="text-green-600 font-medium">Yes</span>
                                }
                                else
                                {
                                    <i class="fas fa-times-circle text-gray-400"></i>
                                    <span class="text-gray-600">No</span>
                                }
                            </span>
                        </div>
                        <div>
                            <span class="text-sm text-gray-600">Active:</span>
                            <span class="ml-2">
                                @if (Model.IsActive)
                                {
                                    <i class="fas fa-check-circle text-green-600"></i>
                                    <span class="text-green-600 font-medium">Yes</span>
                                }
                                else
                                {
                                    <i class="fas fa-times-circle text-red-600"></i>
                                    <span class="text-red-600">No</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Created At -->
                @if (Model.CreatedAt.HasValue)
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-500 mb-1">Uploaded</label>
                        <p class="text-gray-800 flex items-center gap-2">
                            <i class="fas fa-clock text-blue-600"></i>
                            @Model.CreatedAt.Value.ToString("MMMM dd, yyyy 'at' HH:mm")
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

