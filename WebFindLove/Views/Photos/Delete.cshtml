@model WebFindLove.Models.Services.PhotoService.Dto.PhotoDto
@{
    ViewData["Title"] = "Delete Photo";
}

<div class="container mx-auto px-4 py-8 max-w-3xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Back to Photos
        </a>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded">
            <div class="flex items-start">
                <i class="fas fa-exclamation-triangle text-red-500 text-2xl mr-3 mt-1"></i>
                <div>
                    <h1 class="text-2xl font-bold text-red-800">Delete Photo</h1>
                    <p class="text-red-700 mt-1">Are you sure you want to delete this photo? This action cannot be undone.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Photo Preview -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Photo Preview</h3>
            <div class="relative">
                <img src="@Model.PhotoUrl" alt="Photo to delete" 
                     class="w-full rounded-lg shadow"
                     onerror="this.src='https://via.placeholder.com/400x400?text=Failed+to+load+image'">
                
                @if (Model.IsPrimary)
                {
                    <span class="absolute top-2 right-2 bg-yellow-500 text-white px-3 py-1 rounded-full text-sm font-semibold shadow">
                        <i class="fas fa-star mr-1"></i>Primary
                    </span>
                }
            </div>
        </div>

        <!-- Photo Information -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Photo Information</h3>
            
            <dl class="space-y-3">
                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Owner</dt>
                        <dd class="text-gray-800 mt-1">@Model.UserName</dd>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Description</dt>
                        <dd class="text-gray-800 mt-1">@Model.Description</dd>
                    </div>
                }

                <div>
                    <dt class="text-sm font-medium text-gray-500">Status</dt>
                    <dd class="mt-1">
                        @if (Model.IsPrimary)
                        {
                            <span class="inline-block bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-sm">
                                <i class="fas fa-star mr-1"></i>Primary Photo
                            </span>
                        }
                        @if (Model.IsActive)
                        {
                            <span class="inline-block bg-green-100 text-green-800 px-2 py-1 rounded text-sm ml-2">
                                <i class="fas fa-check mr-1"></i>Active
                            </span>
                        }
                    </dd>
                </div>

                @if (Model.CreatedAt.HasValue)
                {
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Uploaded</dt>
                        <dd class="text-gray-800 mt-1">
                            <i class="fas fa-clock mr-1 text-blue-600"></i>
                            @Model.CreatedAt.Value.ToString("MMMM dd, yyyy")
                        </dd>
                    </div>
                }
            </dl>

            <!-- Warning Box -->
            @if (Model.IsPrimary)
            {
                <div class="mt-6 bg-yellow-50 border-l-4 border-yellow-500 p-4 rounded">
                    <div class="flex items-start">
                        <i class="fas fa-exclamation-circle text-yellow-500 mr-2 mt-1"></i>
                        <div>
                            <h4 class="font-semibold text-yellow-800">Warning</h4>
                            <p class="text-yellow-700 text-sm mt-1">
                                This is your primary photo. If you delete it, you'll need to set another photo as primary.
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- Delete Form -->
            <form asp-action="Delete" method="post" class="mt-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                
                <div class="flex gap-3">
                    <button type="submit" 
                            class="flex-1 bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg transition font-semibold"
                            onclick="return confirm('Are you absolutely sure you want to delete this photo?');">
                        <i class="fas fa-trash mr-2"></i>Yes, Delete Photo
                    </button>
                    <a asp-action="Index" 
                       class="flex-1 bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition text-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

