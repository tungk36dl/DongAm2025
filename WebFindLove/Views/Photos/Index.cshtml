@model List<WebFindLove.Models.Services.PhotoService.Dto.PhotoDto>
@{
    ViewData["Title"] = "Photos";
    var search = ViewData["Search"] as WebFindLove.Models.Services.PhotoService.Dto.PhotoSearch;
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Photos</h1>
            <p class="text-gray-600 mt-1">Manage your photos</p>
        </div>
        <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg flex items-center gap-2 transition">
            <i class="fas fa-plus"></i>
            Add Photo
        </a>
    </div>

    <!-- Search & Filter -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Photo URL</label>
                <input type="text" name="SearchTerm" value="@search?.SearchTerm" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                       placeholder="Search by URL...">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Type</label>
                <select name="IsPrimary" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                    <option value="">All Photos</option>
                    <option value="true" selected="@(search?.IsPrimary == true)">Primary Only</option>
                    <option value="false" selected="@(search?.IsPrimary == false)">Non-Primary Only</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                <select name="IsActive" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                    <option value="">All Status</option>
                    <option value="true" selected="@(search?.IsActive == true)">Active</option>
                    <option value="false" selected="@(search?.IsActive == false)">Inactive</option>
                </select>
            </div>
            <div class="md:col-span-3 flex gap-2">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition">
                    <i class="fas fa-search mr-2"></i>Search
                </button>
                <a asp-action="Index" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded-lg transition">
                    <i class="fas fa-redo mr-2"></i>Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Photos Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var photo in Model)
            {
                <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition">
                    <!-- Photo Image -->
                    <div class="relative h-64 bg-gray-200">
                        <img src="@photo.PhotoUrl" alt="Photo" class="w-full h-full object-cover" 
                             onerror="this.src='https://via.placeholder.com/300x300?text=No+Image'">
                        @if (photo.IsPrimary)
                        {
                            <span class="absolute top-2 right-2 bg-yellow-500 text-white px-3 py-1 rounded-full text-xs font-semibold">
                                <i class="fas fa-star mr-1"></i>Primary
                            </span>
                        }
                        @if (!photo.IsActive)
                        {
                            <span class="absolute top-2 left-2 bg-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold">
                                Inactive
                            </span>
                        }
                    </div>

                    <!-- Photo Info -->
                    <div class="p-4">
                        @if (!string.IsNullOrEmpty(photo.Description))
                        {
                            <p class="text-gray-700 mb-3 truncate">@photo.Description</p>
                        }
                        
                        @if (!string.IsNullOrEmpty(photo.UserName))
                        {
                            <p class="text-sm text-gray-500 mb-3">
                                <i class="fas fa-user mr-1"></i>@photo.UserName
                            </p>
                        }

                        <p class="text-xs text-gray-400 mb-4">
                            <i class="fas fa-clock mr-1"></i>@photo.CreatedAt?.ToString("MMM dd, yyyy")
                        </p>

                        <!-- Actions -->
                        <div class="flex gap-2">
                            <a asp-action="Details" asp-route-id="@photo.Id" 
                               class="flex-1 bg-blue-500 hover:bg-blue-600 text-white text-center py-2 rounded transition text-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                            
                            @if (!photo.IsPrimary)
                            {
                                <form asp-action="SetPrimary" asp-route-id="@photo.Id" method="post" class="flex-1">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-white py-2 rounded transition text-sm">
                                        <i class="fas fa-star"></i>
                                    </button>
                                </form>
                            }
                            
                            <a asp-action="Edit" asp-route-id="@photo.Id" 
                               class="flex-1 bg-green-500 hover:bg-green-600 text-white text-center py-2 rounded transition text-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            
                            <a asp-action="Delete" asp-route-id="@photo.Id" 
                               class="flex-1 bg-red-500 hover:bg-red-600 text-white text-center py-2 rounded transition text-sm">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
            <i class="fas fa-images text-gray-400 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">No Photos Found</h3>
            <p class="text-gray-500 mb-6">Get started by adding your first photo!</p>
            <a asp-action="Create" class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition">
                <i class="fas fa-plus mr-2"></i>Add Photo
            </a>
        </div>
    }
</div>

