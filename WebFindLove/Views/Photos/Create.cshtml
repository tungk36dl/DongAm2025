@model WebFindLove.Models.Services.PhotoService.ViewModels.PhotoCreateVM
@{
    ViewData["Title"] = "Add Photo";
}

<div class="container mx-auto px-4 py-8 max-w-2xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Back to Photos
        </a>
        <h1 class="text-3xl font-bold text-gray-800">Add New Photo</h1>
        <p class="text-gray-600 mt-1">Upload a new photo to your profile</p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <!-- Photo URL -->
            <div class="mb-6">
                <label asp-for="PhotoUrl" class="block text-sm font-medium text-gray-700 mb-2">
                    Photo URL <span class="text-red-500">*</span>
                </label>
                <input asp-for="PhotoUrl" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                       placeholder="https://example.com/photo.jpg">
                <span asp-validation-for="PhotoUrl" class="text-red-600 text-sm"></span>
                <p class="text-sm text-gray-500 mt-1">
                    <i class="fas fa-info-circle mr-1"></i>
                    Enter a direct URL to your photo (must be publicly accessible)
                </p>
            </div>

            <!-- Description -->
            <div class="mb-6">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">
                    Description
                </label>
                <textarea asp-for="Description" 
                          rows="3" 
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                          placeholder="Optional: Add a description for this photo..."></textarea>
                <span asp-validation-for="Description" class="text-red-600 text-sm"></span>
            </div>

            <!-- Set as Primary -->
            <div class="mb-6 bg-blue-50 p-4 rounded-lg">
                <label class="flex items-start gap-3 cursor-pointer">
                    <input asp-for="IsPrimary" 
                           type="checkbox" 
                           class="mt-1 rounded text-blue-600 focus:ring-2 focus:ring-blue-500">
                    <div>
                        <span class="text-sm font-medium text-gray-800">Set as primary photo</span>
                        <p class="text-xs text-gray-600 mt-1">
                            Your primary photo will be displayed on your profile and in search results
                        </p>
                    </div>
                </label>
            </div>

            <!-- Buttons -->
            <div class="flex gap-3">
                <button type="submit" 
                        class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Save Photo
                </button>
                <a asp-action="Index" 
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition">
                    Cancel
                </a>
            </div>
        </form>
    </div>

    <!-- Preview Section -->
    <div class="bg-white rounded-lg shadow-md p-6 mt-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Photo Preview</h3>
        <div id="photoPreview" class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center">
            <i class="fas fa-image text-gray-400 text-4xl mb-2"></i>
            <p class="text-gray-500">Enter a URL above to preview your photo</p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Photo preview
        document.querySelector('input[name="PhotoUrl"]').addEventListener('input', function(e) {
            const url = e.target.value;
            const preview = document.getElementById('photoPreview');
            
            if (url) {
                preview.innerHTML = `<img src="${url}" alt="Preview" class="max-h-64 mx-auto rounded-lg" onerror="this.parentElement.innerHTML='<i class=\'fas fa-exclamation-triangle text-red-500 text-4xl mb-2\'></i><p class=\'text-red-500\'>Failed to load image. Please check the URL.</p>'">`;
            } else {
                preview.innerHTML = '<i class="fas fa-image text-gray-400 text-4xl mb-2"></i><p class="text-gray-500">Enter a URL above to preview your photo</p>';
            }
        });
    </script>
}

