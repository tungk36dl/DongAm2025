@model WebFindLove.Models.Services.PhotoService.ViewModels.PhotoUpdateVM
@{
    ViewData["Title"] = "Edit Photo";
}

<div class="container mx-auto px-4 py-8 max-w-2xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Back to Photos
        </a>
        <h1 class="text-3xl font-bold text-gray-800">Edit Photo</h1>
        <p class="text-gray-600 mt-1">Update photo details</p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <!-- Photo URL -->
            <div class="mb-6">
                <label asp-for="PhotoUrl" class="block text-sm font-medium text-gray-700 mb-2">
                    Photo URL <span class="text-red-500">*</span>
                </label>
                <input asp-for="PhotoUrl" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                <span asp-validation-for="PhotoUrl" class="text-red-600 text-sm"></span>
            </div>

            <!-- Description -->
            <div class="mb-6">
                <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">
                    Description
                </label>
                <textarea asp-for="Description" 
                          rows="3" 
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                          placeholder="Optional: Add a description for this photo..."></textarea>
                <span asp-validation-for="Description" class="text-red-600 text-sm"></span>
            </div>

            <!-- Settings -->
            <div class="mb-6 space-y-4">
                <!-- Set as Primary -->
                <div class="bg-blue-50 p-4 rounded-lg">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input asp-for="IsPrimary" 
                               type="checkbox" 
                               class="mt-1 rounded text-blue-600 focus:ring-2 focus:ring-blue-500">
                        <div>
                            <span class="text-sm font-medium text-gray-800">Set as primary photo</span>
                            <p class="text-xs text-gray-600 mt-1">
                                Your primary photo will be displayed on your profile
                            </p>
                        </div>
                    </label>
                </div>

                <!-- Active Status -->
                <div class="bg-green-50 p-4 rounded-lg">
                    <label class="flex items-start gap-3 cursor-pointer">
                        <input asp-for="IsActive" 
                               type="checkbox" 
                               class="mt-1 rounded text-green-600 focus:ring-2 focus:ring-green-500">
                        <div>
                            <span class="text-sm font-medium text-gray-800">Active</span>
                            <p class="text-xs text-gray-600 mt-1">
                                Inactive photos won't be visible on your profile
                            </p>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex gap-3">
                <button type="submit" 
                        class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Save Changes
                </button>
                <a asp-action="Index" 
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition">
                    Cancel
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id"
                   class="ml-auto bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg transition">
                    <i class="fas fa-trash mr-2"></i>Delete
                </a>
            </div>
        </form>
    </div>

    <!-- Current Photo -->
    <div class="bg-white rounded-lg shadow-md p-6 mt-6">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Current Photo</h3>
        <div class="text-center">
            <img src="@Model.PhotoUrl" alt="Current photo" 
                 class="max-h-96 mx-auto rounded-lg shadow-lg"
                 onerror="this.src='https://via.placeholder.com/400x400?text=Failed+to+load+image'">
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

