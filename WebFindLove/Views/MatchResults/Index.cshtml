@model List<WebFindLove.Models.MatchResult>
@{
    ViewData["Title"] = "Người Phù Hợp";
    var currentUserId = Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString());
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-gray-800 mb-2">
            <i class="fas fa-heart text-pink-500 mr-3"></i>Người Phù Hợp Với Tôi
        </h1>
        <p class="text-gray-600 text-lg">Những người tương thích với bạn dựa trên phân tích AI</p>
    </div>

    <!-- Stats -->
    @if (Model != null && Model.Any())
    {
        var avgScore = Model.Where(m => m.MatchScore.HasValue).Average(m => m.MatchScore) ?? 0;
        var topScore = Model.Where(m => m.MatchScore.HasValue).Max(m => m.MatchScore) ?? 0;
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg shadow-md p-6 text-white">
                <div class="text-3xl font-bold">@Model.Count</div>
                <div class="text-blue-100">Tổng Số Người Phù Hợp</div>
            </div>
            <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg shadow-md p-6 text-white">
                <div class="text-3xl font-bold">@avgScore.ToString("F1")%</div>
                <div class="text-purple-100">Điểm Trung Bình</div>
            </div>
            <div class="bg-gradient-to-br from-pink-500 to-pink-600 rounded-lg shadow-md p-6 text-white">
                <div class="text-3xl font-bold">@topScore.ToString("F1")%</div>
                <div class="text-pink-100">Điểm Cao Nhất</div>
            </div>
        </div>

        <!-- Matches Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var match in Model.OrderByDescending(m => m.MatchScore))
            {
                var matchedUser = match.UserId == currentUserId ? match.MatchedUser : match.User;
                
                <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition transform hover:-translate-y-1">
                    <!-- Avatar Header -->
                    <div class="bg-gradient-to-br from-pink-500 to-purple-600 p-6 text-center relative">
                     @if (!string.IsNullOrEmpty(matchedUser?.Avatar))
                     {
                        <img src="@matchedUser.Avatar" alt="@matchedUser.FullName" class="w-24 h-24 rounded-full object-cover border-4 border-pink-200">
                     }
                     else
                     {
                        <div class="w-24 h-24 bg-gradient-to-br from-pink-400 to-purple-500 rounded-full flex items-center justify-center text-white text-3xl font-bold">
                            @(matchedUser?.UserName?.Substring(0, 1).ToUpper())
                        </div>
                     }
                        <h3 class="text-xl font-bold text-white">@matchedUser?.UserName</h3>
                        @if (!string.IsNullOrEmpty(matchedUser?.FullName))
                        {
                            <p class="text-pink-100 text-sm mt-1">@matchedUser.FullName</p>
                        }
                        
                        <!-- Match Score Badge -->
                        <div class="absolute top-4 right-4">
                            <div class="bg-white rounded-full px-3 py-1 shadow-lg">
                                <span class="text-purple-600 font-bold text-sm">@match.MatchScore?.ToString("F0")%</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Match Info -->
                    <div class="p-6">
                        <!-- Match Score Bar -->
                        <div class="mb-4">
                            <div class="flex justify-between mb-2">
                                <span class="text-sm font-medium text-gray-700">Độ Tương Thích</span>
                                <span class="text-sm font-bold text-purple-600">@match.MatchScore?.ToString("F1")%</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3 overflow-hidden">
                                <div class="bg-gradient-to-r from-pink-500 to-purple-600 h-3 rounded-full transition-all duration-500" 
                                     style="width: @(match.MatchScore ?? 0)%"></div>
                            </div>
                        </div>
                        
                        <!-- AI Reasoning -->
                        @if (!string.IsNullOrEmpty(match.AiReasoning))
                        {
                            <div class="mb-4 p-3 bg-purple-50 rounded-lg border border-purple-100">
                                <div class="flex items-start gap-2">
                                    <i class="fas fa-brain text-purple-600 mt-1"></i>
                                    <p class="text-sm text-gray-700 leading-relaxed">@match.AiReasoning</p>
                                </div>
                            </div>
                        }
                        
                        <!-- User Info -->
                        <div class="space-y-2 mb-4">
                            @if (!string.IsNullOrEmpty(matchedUser?.Email))
                            {
                                <p class="text-sm text-gray-600 flex items-center gap-2">
                                    <i class="fas fa-envelope text-blue-500"></i>
                                    @matchedUser.Email
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(matchedUser?.Location))
                            {
                                <p class="text-sm text-gray-600 flex items-center gap-2">
                                    <i class="fas fa-map-marker-alt text-red-500"></i>
                                    @matchedUser.Location
                                </p>
                            }
                        </div>
                        
                        <!-- Actions -->
                        <div class="flex gap-2">
                            <a asp-controller="Messages" asp-action="Conversation" asp-route-userId="@matchedUser?.Id" 
                               class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-center py-2 rounded-lg transition font-medium">
                                <i class="fas fa-comment mr-1"></i>Nhắn Tin
                            </a>
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@matchedUser?.Id"
                               class="flex-1 bg-purple-600 hover:bg-purple-700 text-white text-center py-2 rounded-lg transition font-medium">
                                <i class="fas fa-user mr-1"></i>Hồ Sơ
                            </a>
                            <form asp-action="Delete" asp-route-id="@match.Id" method="post" class="flex-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" 
                                        class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg transition"
                                        onclick="return confirm('Xóa người này?');">
                                    <i class="fas fa-times"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="bg-white rounded-lg shadow-md p-12 text-center max-w-2xl mx-auto">
            <div class="mb-6">
                <i class="fas fa-heart-broken text-gray-300 text-6xl mb-4"></i>
                <h3 class="text-2xl font-semibold text-gray-700 mb-2">Chưa Có Người Phù Hợp</h3>
                <p class="text-gray-500 mb-6">
                    Hoàn thành hồ sơ và thiết lập sở thích để bắt đầu tìm kiếm người phù hợp!
                </p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
                <div class="p-4 bg-blue-50 rounded-lg">
                    <div class="text-blue-600 text-2xl mb-2">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 mb-1">Hoàn Thành Hồ Sơ</h4>
                    <p class="text-sm text-gray-600">Thêm thông tin và ảnh của bạn</p>
                </div>
                <div class="p-4 bg-purple-50 rounded-lg">
                    <div class="text-purple-600 text-2xl mb-2">
                        <i class="fas fa-sliders-h"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 mb-1">Thiết Lập Sở Thích</h4>
                    <p class="text-sm text-gray-600">Cho chúng tôi biết bạn đang tìm kiếm gì</p>
                </div>
                <div class="p-4 bg-pink-50 rounded-lg">
                    <div class="text-pink-600 text-2xl mb-2">
                        <i class="fas fa-brain"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 mb-1">Phân Tích AI</h4>
                    <p class="text-sm text-gray-600">AI sẽ tìm người phù hợp nhất cho bạn</p>
                </div>
            </div>
            
            <div class="mt-8 flex gap-4 justify-center">
                <a asp-controller="Users" asp-action="Edit" asp-route-id="@currentUserId" 
                   class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg transition font-medium">
                    <i class="fas fa-user-edit mr-2"></i>Chỉnh Sửa Hồ Sơ
                </a>
                <a asp-controller="UserPreferences" asp-action="Edit" 
                   class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg transition font-medium">
                    <i class="fas fa-sliders-h mr-2"></i>Thiết Lập Sở Thích
                </a>
            </div>
        </div>
    }
</div>

