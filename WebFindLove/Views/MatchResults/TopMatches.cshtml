@model List<WebFindLove.Models.MatchResult>
@{
    ViewData["Title"] = "Top Matches";
    var count = ViewData["Count"] as int? ?? 10;
    var currentUserId = Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? Guid.Empty.ToString());
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Back to All Matches
        </a>
        <div class="text-center">
            <h1 class="text-4xl font-bold text-gray-800 mb-2">
                <i class="fas fa-trophy text-yellow-500 mr-3"></i>Top @count Matches
            </h1>
            <p class="text-gray-600 text-lg">Your highest compatibility matches</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Podium (Top 3) -->
        @if (Model.Count >= 3)
        {
            var top3 = Model.Take(3).ToList();
            
            <div class="mb-12">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">🏆 Top 3 Champions 🏆</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
                    <!-- 2nd Place -->
                    @if (top3.Count > 1)
                    {
                        var match2 = top3[1];
                        var matchedUser2 = match2.UserId == currentUserId ? match2.MatchedUser : match2.User;
                        
                        <div class="order-2 md:order-1 transform md:translate-y-8">
                            <div class="bg-gradient-to-br from-gray-300 to-gray-400 rounded-t-lg p-4 text-center">
                                <div class="text-4xl mb-2">🥈</div>
                                <div class="text-white font-bold text-lg">#2</div>
                            </div>
                            <div class="bg-white rounded-b-lg shadow-xl p-6">
                                <div class="w-20 h-20 bg-gradient-to-br from-gray-400 to-gray-500 rounded-full mx-auto flex items-center justify-center text-2xl font-bold text-white mb-3">
                                    @(matchedUser2?.UserName?.Substring(0, 1).ToUpper())
                                </div>
                                <h3 class="text-xl font-bold text-gray-800 text-center mb-2">@matchedUser2?.UserName</h3>
                                <div class="text-center mb-4">
                                    <span class="text-3xl font-bold text-gray-600">@match2.MatchScore?.ToString("F0")%</span>
                                </div>
                                <a asp-controller="Messages" asp-action="Conversation" asp-route-userId="@matchedUser2?.Id"
                                   class="block bg-gray-500 hover:bg-gray-600 text-white text-center py-2 rounded-lg transition">
                                    <i class="fas fa-comment mr-1"></i>Message
                                </a>
                            </div>
                        </div>
                    }

                    <!-- 1st Place -->
                    @{
                        var match1 = top3[0];
                        var matchedUser1 = match1.UserId == currentUserId ? match1.MatchedUser : match1.User;
                    }
                    <div class="order-1 md:order-2">
                        <div class="bg-gradient-to-br from-yellow-400 to-yellow-500 rounded-t-lg p-4 text-center">
                            <div class="text-5xl mb-2">👑</div>
                            <div class="text-white font-bold text-xl">#1</div>
                        </div>
                        <div class="bg-white rounded-b-lg shadow-2xl p-6">
                            <div class="w-24 h-24 bg-gradient-to-br from-yellow-400 to-yellow-500 rounded-full mx-auto flex items-center justify-center text-3xl font-bold text-white mb-3 ring-4 ring-yellow-200">
                                @(matchedUser1?.UserName?.Substring(0, 1).ToUpper())
                            </div>
                            <h3 class="text-2xl font-bold text-gray-800 text-center mb-2">@matchedUser1?.UserName</h3>
                            <div class="text-center mb-4">
                                <span class="text-4xl font-bold text-yellow-500">@match1.MatchScore?.ToString("F0")%</span>
                            </div>
                            <a asp-controller="Messages" asp-action="Conversation" asp-route-userId="@matchedUser1?.Id"
                               class="block bg-yellow-500 hover:bg-yellow-600 text-white text-center py-2 rounded-lg transition font-medium">
                                <i class="fas fa-comment mr-1"></i>Message
                            </a>
                        </div>
                    </div>

                    <!-- 3rd Place -->
                    @if (top3.Count > 2)
                    {
                        var match3 = top3[2];
                        var matchedUser3 = match3.UserId == currentUserId ? match3.MatchedUser : match3.User;
                        
                        <div class="order-3 transform md:translate-y-12">
                            <div class="bg-gradient-to-br from-orange-400 to-orange-500 rounded-t-lg p-4 text-center">
                                <div class="text-4xl mb-2">🥉</div>
                                <div class="text-white font-bold text-lg">#3</div>
                            </div>
                            <div class="bg-white rounded-b-lg shadow-xl p-6">
                                <div class="w-20 h-20 bg-gradient-to-br from-orange-400 to-orange-500 rounded-full mx-auto flex items-center justify-center text-2xl font-bold text-white mb-3">
                                    @(matchedUser3?.UserName?.Substring(0, 1).ToUpper())
                                </div>
                                <h3 class="text-xl font-bold text-gray-800 text-center mb-2">@matchedUser3?.UserName</h3>
                                <div class="text-center mb-4">
                                    <span class="text-3xl font-bold text-orange-500">@match3.MatchScore?.ToString("F0")%</span>
                                </div>
                                <a asp-controller="Messages" asp-action="Conversation" asp-route-userId="@matchedUser3?.Id"
                                   class="block bg-orange-500 hover:bg-orange-600 text-white text-center py-2 rounded-lg transition">
                                    <i class="fas fa-comment mr-1"></i>Message
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Remaining Matches -->
        @if (Model.Count > 3)
        {
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Other Top Matches</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @for (int i = 3; i < Model.Count; i++)
                {
                    var match = Model[i];
                    var matchedUser = match.UserId == currentUserId ? match.MatchedUser : match.User;
                    
                    <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-xl transition">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="text-3xl font-bold text-gray-400">#{i + 1}</div>
                            <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-xl font-bold text-white">
                                @(matchedUser?.UserName?.Substring(0, 1).ToUpper())
                            </div>
                            <div class="flex-1">
                                <h3 class="text-lg font-bold text-gray-800">@matchedUser?.UserName</h3>
                                <div class="text-2xl font-bold text-purple-600">@match.MatchScore?.ToString("F0")%</div>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <a asp-controller="Messages" asp-action="Conversation" asp-route-userId="@matchedUser?.Id"
                               class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-center py-2 rounded-lg transition text-sm">
                                <i class="fas fa-comment mr-1"></i>Message
                            </a>
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@matchedUser?.Id"
                               class="flex-1 bg-purple-600 hover:bg-purple-700 text-white text-center py-2 rounded-lg transition text-sm">
                                <i class="fas fa-user mr-1"></i>Profile
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
            <i class="fas fa-trophy text-gray-400 text-6xl mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">No Matches Available</h3>
            <p class="text-gray-500">Complete your profile to start finding matches!</p>
        </div>
    }
</div>

