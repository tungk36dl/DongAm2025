@model WebFindLove.Models.Role

@{
    ViewData["Title"] = "Delete Role";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a asp-action="Index" class="text-primary hover:text-pink-600 font-medium">
            <i class="fas fa-arrow-left mr-2"></i>Back to Roles List
        </a>
    </div>

    <div class="bg-white rounded-lg shadow-md p-8">
        <div class="text-center mb-8">
            <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-red-100 mb-4">
                <i class="fas fa-exclamation-triangle text-4xl text-red-600"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Delete Role</h1>
            <p class="text-gray-600">Are you sure you want to delete this role?</p>
        </div>

        <div class="bg-gray-50 rounded-lg p-6 mb-6">
            <div class="flex items-center mb-6">
                <div class="h-16 w-16 rounded-full bg-gradient-to-r from-primary to-secondary flex items-center justify-center">
                    <i class="fas fa-user-shield text-3xl text-white"></i>
                </div>
                <div class="ml-4">
                    <h3 class="text-xl font-bold text-gray-800">@Model.Name</h3>
                    <p class="text-gray-600">@(Model.Description ?? "No description")</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-gray-200 pt-4">
                <div>
                    <label class="text-sm font-semibold text-gray-500 uppercase">Status</label>
                    <p class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-green-100 text-green-800">
                                <i class="fas fa-check-circle mr-1"></i>Active
                            </span>
                        }
                        else
                        {
                            <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-red-100 text-red-800">
                                <i class="fas fa-times-circle mr-1"></i>Inactive
                            </span>
                        }
                    </p>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-500 uppercase">Users with this Role</label>
                    <p class="mt-1 text-gray-800">
                        <span class="text-2xl font-bold text-primary">@(Model.Users?.Count ?? 0)</span> users
                    </p>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-500 uppercase">Created At</label>
                    <p class="mt-1 text-gray-800">@Model.CreatedAt?.ToString("MMM dd, yyyy")</p>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-500 uppercase">Last Updated</label>
                    <p class="mt-1 text-gray-800">@Model.UpdatedAt?.ToString("MMM dd, yyyy")</p>
                </div>
            </div>
        </div>

        @if (Model.Users != null && Model.Users.Any())
        {
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 mb-6 rounded">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <i class="fas fa-exclamation-triangle text-yellow-500"></i>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-yellow-700">
                            <strong>Warning:</strong> This role is currently assigned to <strong>@Model.Users.Count user(s)</strong>. Deleting this role may affect these users' access and permissions.
                        </p>
                    </div>
                </div>
            </div>
        }

        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-circle text-red-500"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-red-700">
                        <strong>Warning:</strong> This action cannot be undone. All role data will be permanently deleted.
                    </p>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="flex justify-end space-x-4">
                <a asp-action="Index" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition font-medium">
                    <i class="fas fa-times mr-2"></i>Cancel
                </a>
                <button type="submit" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition font-medium">
                    <i class="fas fa-trash mr-2"></i>Yes, Delete Role
                </button>
            </div>
        </form>
    </div>
</div>

