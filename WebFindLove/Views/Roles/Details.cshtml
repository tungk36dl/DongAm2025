@model WebFindLove.Models.Role

@{
    ViewData["Title"] = "Role Details";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-6">
        <a asp-action="Index" class="text-primary hover:text-pink-600 font-medium">
            <i class="fas fa-arrow-left mr-2"></i>Back to Roles List
        </a>
    </div>

    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <!-- Header Section -->
        <div class="bg-gradient-to-r from-primary to-secondary p-8 text-white">
            <div class="flex items-center">
                <div class="h-24 w-24 rounded-full bg-white flex items-center justify-center shadow-lg">
                    <i class="fas fa-user-shield text-5xl text-primary"></i>
                </div>
                <div class="ml-6">
                    <h1 class="text-3xl font-bold">@Model.Name</h1>
                    <p class="text-pink-100 mt-1">System Role</p>
                    <div class="mt-3">
                        @if (Model.IsActive)
                        {
                            <span class="px-4 py-1 bg-green-500 text-white text-sm font-semibold rounded-full">
                                <i class="fas fa-check-circle mr-1"></i>Active
                            </span>
                        }
                        else
                        {
                            <span class="px-4 py-1 bg-red-500 text-white text-sm font-semibold rounded-full">
                                <i class="fas fa-times-circle mr-1"></i>Inactive
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Section -->
        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="border-b border-gray-200 pb-4">
                    <label class="text-sm font-semibold text-gray-500 uppercase">
                        <i class="fas fa-id-card mr-2"></i>Role ID
                    </label>
                    <p class="mt-2 text-gray-800 font-medium">@Model.Id</p>
                </div>

                <div class="border-b border-gray-200 pb-4">
                    <label class="text-sm font-semibold text-gray-500 uppercase">
                        <i class="fas fa-tag mr-2"></i>Role Name
                    </label>
                    <p class="mt-2 text-gray-800 font-medium">@Model.Name</p>
                </div>

                <div class="md:col-span-2 border-b border-gray-200 pb-4">
                    <label class="text-sm font-semibold text-gray-500 uppercase">
                        <i class="fas fa-align-left mr-2"></i>Description
                    </label>
                    <p class="mt-2 text-gray-800">@(Model.Description ?? "No description available")</p>
                </div>

                <div class="border-b border-gray-200 pb-4">
                    <label class="text-sm font-semibold text-gray-500 uppercase">
                        <i class="fas fa-toggle-on mr-2"></i>Status
                    </label>
                    <p class="mt-2">
                        @if (Model.IsActive)
                        {
                            <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-green-100 text-green-800">
                                <i class="fas fa-check-circle mr-1"></i>Active
                            </span>
                        }
                        else
                        {
                            <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-red-100 text-red-800">
                                <i class="fas fa-times-circle mr-1"></i>Inactive
                            </span>
                        }
                    </p>
                </div>

                <div class="border-b border-gray-200 pb-4">
                    <label class="text-sm font-semibold text-gray-500 uppercase">
                        <i class="fas fa-users mr-2"></i>Users Count
                    </label>
                    <p class="mt-2 text-gray-800 font-medium">
                        <span class="text-2xl text-primary">@(Model.Users?.Count ?? 0)</span> users
                    </p>
                </div>

                <div class="border-b border-gray-200 pb-4">
                    <label class="text-sm font-semibold text-gray-500 uppercase">
                        <i class="fas fa-calendar-plus mr-2"></i>Created At
                    </label>
                    <p class="mt-2 text-gray-800 font-medium">@Model.CreatedAt?.ToString("MMMM dd, yyyy HH:mm")</p>
                </div>

                <div class="border-b border-gray-200 pb-4">
                    <label class="text-sm font-semibold text-gray-500 uppercase">
                        <i class="fas fa-calendar-check mr-2"></i>Last Updated
                    </label>
                    <p class="mt-2 text-gray-800 font-medium">@Model.UpdatedAt?.ToString("MMMM dd, yyyy HH:mm")</p>
                </div>
            </div>

            @if (Model.Users != null && Model.Users.Any())
            {
                <div class="mt-8">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-users text-primary mr-2"></i>Users with this Role
                    </h3>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                            @foreach (var user in Model.Users.Take(6))
                            {
                                <div class="flex items-center space-x-3 bg-white p-3 rounded-lg shadow-sm">
                                    <div class="h-10 w-10 rounded-full bg-gradient-to-r from-primary to-secondary flex items-center justify-center text-white font-bold">
                                        @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-800">@user.UserName</p>
                                        <p class="text-xs text-gray-500">@user.Email</p>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (Model.Users.Count > 6)
                        {
                            <p class="text-center text-gray-600 mt-4">
                                And @(Model.Users.Count - 6) more users...
                            </p>
                        }
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="mt-8 flex justify-end space-x-4">
                <a asp-action="Index" class="px-6 py-3 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition font-medium">
                    <i class="fas fa-list mr-2"></i>Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-medium">
                    <i class="fas fa-edit mr-2"></i>Edit Role
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition font-medium">
                    <i class="fas fa-trash mr-2"></i>Delete Role
                </a>
            </div>
        </div>
    </div>
</div>

