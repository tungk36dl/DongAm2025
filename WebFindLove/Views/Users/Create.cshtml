@model WebFindLove.Models.Services.UserService.ViewModels.UserCreateVM

@{
    ViewData["Title"] = "Tạo Người Dùng";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6">
        <a asp-action="Index" class="text-primary hover:text-pink-600 font-medium">
            <i class="fas fa-arrow-left mr-2"></i>Quay Lại Danh Sách
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8">
        <div class="mb-6">
            <h1 class="text-3xl font-bold text-gray-800 dark:text-white">
                <i class="fas fa-user-plus text-primary mr-2"></i>Tạo Người Dùng Mới
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-2">Thêm một người dùng mới vào hệ thống</p>
        </div>

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="bg-red-100 dark:bg-red-900 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-200 px-4 py-3 rounded-lg mb-4"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label asp-for="UserName" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-user mr-2"></i>Tên Đăng Nhập <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="UserName" 
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                           placeholder="Nhập tên đăng nhập" />
                    <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-envelope mr-2"></i>Email <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Email" 
                           type="email"
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                           placeholder="Nhập địa chỉ email" />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="FullName" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-id-card mr-2"></i>Họ và Tên
                    </label>
                    <input asp-for="FullName" 
                           class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                           placeholder="Nhập họ và tên" />
                    <span asp-validation-for="FullName" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Role" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-user-shield mr-2"></i>Vai Trò
                    </label>
                    <select asp-for="Role" 
                            asp-items="ViewBag.Roles"
                            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                        <option value="">Chọn vai trò</option>
                    </select>
                    <span asp-validation-for="Role" class="text-red-500 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-gray-700 dark:text-gray-300 font-semibold mb-2">
                        <i class="fas fa-lock mr-2"></i>Mật Khẩu <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="Password" 
                               type="password"
                               id="Password"
                               class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white"
                               placeholder="Nhập mật khẩu" />
                        <button type="button" 
                                onclick="togglePassword()" 
                                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700">
                            <i class="fas fa-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Tối thiểu 6 ký tự</p>
                </div>

                <div class="flex items-center">
                    <label class="flex items-center cursor-pointer">
                        <input asp-for="IsActive" 
                               type="checkbox" 
                               class="w-5 h-5 text-primary border-gray-300 rounded focus:ring-primary" />
                        <span class="ml-3 text-gray-700 dark:text-gray-300 font-semibold">
                            <i class="fas fa-toggle-on mr-2"></i>Đang Hoạt Động
                        </span>
                    </label>
                </div>
            </div>

            <div class="mt-8 flex justify-end space-x-4">
                <a asp-action="Index" class="px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition font-medium">
                    <i class="fas fa-times mr-2"></i>Hủy
                </a>
                <button type="submit" class="bg-gradient-to-r from-primary to-secondary text-white px-6 py-3 rounded-lg hover:shadow-lg transition font-medium">
                    <i class="fas fa-save mr-2"></i>Tạo Người Dùng
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('Password');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }
    </script>
}
