@model WebFindLove.Models.Services.UserService.ViewModels.EditProfileVM

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="max-w-6xl mx-auto px-4 py-8">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg overflow-hidden">
        <div class="bg-gradient-to-r from-secondary to-purple-600 text-white px-6 py-4">
            <h2 class="text-2xl font-bold flex items-center">
                <i class="fas fa-user-edit mr-3"></i>
                Chỉnh Sửa Hồ Sơ Cá Nhân
            </h2>
        </div>
        
        <div class="p-6 md:p-8">
            <!-- Free Updates Info -->
            @{
                var freeUpdates = ViewBag.FreeProfileUpdatesLeft ?? 0;
            }
            <div class="mb-6 @(freeUpdates > 0 ? "bg-blue-50 dark:bg-blue-900" : "bg-red-50 dark:bg-red-900") border-l-4 @(freeUpdates > 0 ? "border-blue-500" : "border-red-500") p-4 rounded-lg">
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <i class="fas fa-sync-alt mr-3 @(freeUpdates > 0 ? "text-blue-500" : "text-red-500")"></i>
                        <div>
                            <p class="font-semibold @(freeUpdates > 0 ? "text-blue-800 dark:text-blue-200" : "text-red-800 dark:text-red-200")">
                                Số lần cập nhật còn lại: 
                                <span class="text-2xl font-bold">@freeUpdates</span> lần
                            </p>
                            @if (freeUpdates == 0)
                            {
                                <p class="text-sm text-red-700 dark:text-red-300 mt-1">
                                    Bạn đã hết lượt cập nhật miễn phí. Vui lòng liên hệ admin để được hỗ trợ.
                                </p>
                            }
                        </div>
                    </div>
                    @if (freeUpdates > 0)
                    {
                        <div class="px-4 py-2 bg-blue-100 dark:bg-blue-800 rounded-full">
                            <span class="text-blue-800 dark:text-blue-200 font-semibold">
                                @(freeUpdates == 1 ? "Lượt cuối cùng" : "")
                            </span>
                        </div>
                    }
                </div>
            </div>
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="bg-green-100 dark:bg-green-900 border border-green-400 dark:border-green-600 text-green-700 dark:text-green-200 px-4 py-3 rounded-lg mb-6 flex items-center justify-between animate-fade-in">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="text-green-700 dark:text-green-200 hover:text-green-900 dark:hover:text-green-100">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }

            <!-- Loading Overlay -->
            <div id="loadingOverlay" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
                <div class="bg-white dark:bg-gray-800 rounded-lg p-8 flex flex-col items-center">
                    <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-purple-600 mb-4"></div>
                    <p class="text-gray-700 dark:text-gray-300 text-lg font-semibold">Đang xử lý...</p>
                    <p class="text-gray-500 dark:text-gray-400 text-sm mt-2">Vui lòng đợi trong giây lát</p>
                </div>
            </div>

            <!-- Notification Popup -->
            <div id="notificationPopup" class="hidden fixed top-4 right-4 z-[60] max-w-md w-full">
                <div id="notificationContent" class="bg-white dark:bg-gray-800 rounded-lg shadow-2xl border-l-4 p-4 flex items-start space-x-3 animate-slide-in-right">
                    <div id="notificationIcon" class="flex-shrink-0 text-2xl"></div>
                    <div class="flex-1 min-w-0">
                        <p id="notificationTitle" class="text-sm font-semibold mb-1"></p>
                        <p id="notificationMessage" class="text-sm"></p>
                    </div>
                    <button onclick="closeNotification()" class="flex-shrink-0 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            
            <form asp-action="EditProfile" method="post" enctype="multipart/form-data" class="space-y-6" id="editForm">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Avatar" />
                <div asp-validation-summary="ModelOnly" class="bg-red-100 dark:bg-red-900 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-200 px-4 py-3 rounded-lg mb-4"></div>

                <!-- Avatar Section -->
                <div class="space-y-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-camera mr-2 text-primary"></i>
                        Ảnh Đại Diện
                    </h3>
                    
                    <div class="flex flex-col md:flex-row items-center gap-6 bg-gray-50 dark:bg-gray-700 p-6 rounded-lg">
                        @if (!string.IsNullOrEmpty(Model.Avatar))
                        {
                            <div class="flex-shrink-0">
                                <img src="@Model.Avatar" 
                                     alt="Current Avatar" 
                                     id="avatar-preview"
                                     class="w-40 h-40 rounded-full border-4 border-primary object-cover shadow-lg" />
                            </div>
                        }
                        else
                        {
                            <div class="flex-shrink-0">
                                <div id="avatar-preview" class="w-40 h-40 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center shadow-lg">
                                    <i class="fas fa-user text-white text-6xl"></i>
                                </div>
                            </div>
                        }
                        
                        <div class="flex-1 w-full">
                            <label asp-for="AvatarFile" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-upload mr-1"></i> Tải Ảnh Mới Lên
                            </label>
                            <input asp-for="AvatarFile" 
                                   type="file" 
                                   accept="image/*" 
                                   class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-600 text-gray-900 dark:text-white transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-pink-600" />
                            <span asp-validation-for="AvatarFile" class="text-red-500 text-sm mt-1"></span>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">
                                <i class="fas fa-info-circle mr-1"></i>
                                Định dạng hỗ trợ: JPG, JPEG, PNG, GIF (Tối đa 5MB)
                            </p>
                        </div>
                    </div>
                </div>

                <hr class="border-gray-300 dark:border-gray-600" />

                <!-- Basic Information -->
                <div class="space-y-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-info-circle mr-2 text-blue-500"></i>
                        Thông Tin Cơ Bản
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="FullName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-user mr-1"></i> Họ và Tên
                            </label>
                            <input asp-for="FullName" 
                                   class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition" 
                                   placeholder="Nhập họ và tên" />
                            <span asp-validation-for="FullName" class="text-red-500 text-sm mt-1"></span>
                        </div>

                        <div>
                            <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-phone mr-1"></i> Số Điện Thoại <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="PhoneNumber" 
                                   class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition" 
                                   placeholder="Nhập số điện thoại"
                                   required />
                            <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm mt-1"></span>
                        </div>

                        <div>
                            <label asp-for="Gender" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-venus-mars mr-1"></i> Giới Tính <span class="text-red-500">*</span>
                            </label>
                            <select asp-for="Gender" 
                                    class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition"
                                    required>
                                <option value="">Chọn giới tính</option>
                                <option value="male">Nam</option>
                                <option value="female">Nữ</option>
                                <option value="other">Khác</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-red-500 text-sm mt-1"></span>
                        </div>

                        <div>
                            <label asp-for="DateOfBirth" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-calendar mr-1"></i> Ngày Sinh <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="DateOfBirth" 
                                   type="date" 
                                   class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition"
                                   required />
                            <span asp-validation-for="DateOfBirth" class="text-red-500 text-sm mt-1"></span>
                        </div>

                        <div class="md:col-span-2">
                            <label asp-for="Height" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-ruler-vertical mr-1"></i> Chiều Cao (cm) <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="Height" 
                                   type="number" 
                                   min="100"
                                   max="250"
                                   class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition" 
                                   placeholder="Nhập chiều cao"
                                   required />
                            <span asp-validation-for="Height" class="text-red-500 text-sm mt-1"></span>
                        </div>
                    </div>
                </div>

                <hr class="border-gray-300 dark:border-gray-600" />

                <!-- Location Information -->
                <div class="space-y-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                        Thông Tin Địa Chỉ
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Location" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-location-arrow mr-1"></i> Địa Chỉ Hiện Tại <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="Location" 
                                   class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition" 
                                   placeholder="Nhập địa chỉ hiện tại"
                                   required />
                            <span asp-validation-for="Location" class="text-red-500 text-sm mt-1"></span>
                        </div>

                        <div>
                            <label asp-for="Hometown" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                                <i class="fas fa-home mr-1"></i> Quê Quán <span class="text-red-500">*</span>
                            </label>
                            <input asp-for="Hometown" 
                                   class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition" 
                                   placeholder="Nhập quê quán" required />
                            <span asp-validation-for="Hometown" class="text-red-500 text-sm mt-1"></span>
                        </div>
                    </div>
                </div>

                <hr class="border-gray-300 dark:border-gray-600" />

                <!-- About Me -->
                <div class="space-y-4">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center">
                        <i class="fas fa-pen-fancy mr-2 text-green-500"></i>
                        Giới Thiệu Bản Thân
                    </h3>
                    
                    <div>
                        <label asp-for="Bio" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-book-open mr-1"></i> Tiểu Sử
                        </label>
                        <textarea asp-for="Bio" 
                                  rows="4" 
                                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition resize-none" 
                                  placeholder="Viết vài dòng về bản thân bạn..."></textarea>
                        <span asp-validation-for="Bio" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Interests" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-heart mr-1"></i> Sở Thích <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Interests" 
                               class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition" 
                               placeholder="Nhập sở thích (cách nhau bởi dấu phẩy). Nhập càng chi tiết matching càng chuân"
                               required />
                        <span asp-validation-for="Interests" class="text-red-500 text-sm mt-1"></span>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            Ví dụ: Đọc sách, Du lịch, Âm nhạc, Thể thao, chơi liên quân, free fire,... 
                        </p>
                    </div>

                    <div>
                        <label asp-for="PersonalityType" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-brain mr-1"></i> Nhóm Tính Cách 
                        </label>
                        <select asp-for="PersonalityType" 
                                class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition"
                                >
                            <option value="">Chọn nhóm tính cách của bạn</option>
                            <optgroup label="Nhà Phân Tích">
                                <option value="INTJ">INTJ - Kiến Trúc Sư</option>
                                <option value="INTP">INTP - Nhà Logic</option>
                                <option value="ENTJ">ENTJ - Chỉ Huy</option>
                                <option value="ENTP">ENTP - Nhà Tranh Luận</option>
                            </optgroup>
                            <optgroup label="Nhà Ngoại Giao">
                                <option value="INFJ">INFJ - Người Ủng Hộ</option>
                                <option value="INFP">INFP - Nhà Hòa Giải</option>
                                <option value="ENFJ">ENFJ - Người Chủ Đạo</option>
                                <option value="ENFP">ENFP - Người Vận Động</option>
                            </optgroup>
                            <optgroup label="Người Bảo Vệ">
                                <option value="ISTJ">ISTJ - Nhà Hậu Cần</option>
                                <option value="ISFJ">ISFJ - Người Bảo Vệ</option>
                                <option value="ESTJ">ESTJ - Giám Đốc</option>
                                <option value="ESFJ">ESFJ - Lãnh Sự</option>
                            </optgroup>
                            <optgroup label="Nhà Thám Hiểm">
                                <option value="ISTP">ISTP - Nhà Kỹ Thuật</option>
                                <option value="ISFP">ISFP - Nhà Phiêu Lưu</option>
                                <option value="ESTP">ESTP - Doanh Nhân</option>
                                <option value="ESFP">ESFP - Nghệ Sĩ</option>
                            </optgroup>
                        </select>
                        <span asp-validation-for="PersonalityType" class="text-red-500 text-sm mt-1"></span>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            <i class="fas fa-info-circle mr-1"></i>
                            Chưa biết nhóm của bạn? 
                            <!-- <a href="https://www.16personalities.com/free-personality-test" target="_blank" class="text-primary hover:underline">
                                Làm bài test <i class="fas fa-external-link-alt text-xs"></i>
                            </a> -->
                            <span class="text-primary hover:underline" onClick="alert('Tính năng đang phát triển')";>
                                Làm bài testt
                            </span>
                        </p>
                    </div>

                    <div>
                        <label asp-for="PersonalityText" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <i class="fas fa-quote-left mr-1"></i> Mô Tả Tính Cách <span class="text-red-500">*</span>
                        </label>
                        <textarea asp-for="PersonalityText" 
                                  rows="4" 
                                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white transition resize-none" 
                                  placeholder="Nhập tính cách bằng các tính từ chỉ tính cách, cách nhau bởi dấu phẩy" required></textarea>
                        <span asp-validation-for="PersonalityText" class="text-red-500 text-sm mt-1"></span>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            <i class="fas fa-info-circle mr-1"></i>
                            Mô tả tính cách của bạn bằng lời của chính bạn (tùy chọn)
                        </p>
                    </div>
                </div>

                <hr class="border-gray-300 dark:border-gray-600" />

                <!-- Action Buttons -->
                <div class="flex flex-wrap gap-3">
                    <button type="submit" 
                            id="submitBtn"
                            @if (freeUpdates == 0) { @:disabled
                            }
                            class="@(freeUpdates == 0 ? "bg-gray-400 cursor-not-allowed" : "bg-gradient-to-r from-secondary to-purple-600 hover:shadow-lg") text-white px-6 py-3 rounded-lg transition font-medium flex items-center">
                        <i class="fas fa-save mr-2"></i>
                        <span id="submitText">@(freeUpdates == 0 ? "Đã Hết Lượt" : "Lưu Hồ Sơ")</span>
                    </button>
                    <a asp-action="EditAccount" class="bg-gradient-to-r from-primary to-pink-600 text-white px-6 py-3 rounded-lg hover:shadow-lg transition font-medium flex items-center">
                        <i class="fas fa-user-circle mr-2"></i>
                        Sửa Tài Khoản
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 px-6 py-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition font-medium flex items-center">
                        <i class="fas fa-arrow-left mr-2"></i>
                        Về Trang Chủ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <style>
        @@keyframes slide-in-right {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        
        .animate-slide-in-right {
            animation: slide-in-right 0.3s ease-out;
        }
    </style>
    <script>
        // Preview image before upload
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const preview = document.getElementById('avatar-preview');
                    if (preview) {
                        if (preview.tagName === 'IMG') {
                            preview.src = event.target.result;
                        } else {
                            preview.innerHTML = `<img src="${event.target.result}" class="w-40 h-40 rounded-full object-cover" />`;
                        }
                    }
                };
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        // Loading indicator và form validation
        const form = document.getElementById('editForm');
        const submitBtn = document.getElementById('submitBtn');
        const submitText = document.getElementById('submitText');
        const loadingOverlay = document.getElementById('loadingOverlay');
        let isSubmitting = false; // Flag để tránh submit nhiều lần
        
        // Hàm hiển thị notification popup
        function showNotification(type, title, message) {
            const popup = document.getElementById('notificationPopup');
            const content = document.getElementById('notificationContent');
            const icon = document.getElementById('notificationIcon');
            const titleEl = document.getElementById('notificationTitle');
            const messageEl = document.getElementById('notificationMessage');
            
            // Reset classes
            content.className = 'bg-white dark:bg-gray-800 rounded-lg shadow-2xl border-l-4 p-4 flex items-start space-x-3 animate-slide-in-right';
            icon.className = 'flex-shrink-0 text-2xl';
            
            if (type === 'error') {
                content.classList.add('border-red-500');
                icon.innerHTML = '<i class="fas fa-exclamation-circle text-red-500"></i>';
                titleEl.className = 'text-sm font-semibold mb-1 text-red-800 dark:text-red-200';
                messageEl.className = 'text-sm text-red-700 dark:text-red-300';
            } else if (type === 'success') {
                content.classList.add('border-green-500');
                icon.innerHTML = '<i class="fas fa-check-circle text-green-500"></i>';
                titleEl.className = 'text-sm font-semibold mb-1 text-green-800 dark:text-green-200';
                messageEl.className = 'text-sm text-green-700 dark:text-green-300';
            } else if (type === 'warning') {
                content.classList.add('border-yellow-500');
                icon.innerHTML = '<i class="fas fa-exclamation-triangle text-yellow-500"></i>';
                titleEl.className = 'text-sm font-semibold mb-1 text-yellow-800 dark:text-yellow-200';
                messageEl.className = 'text-sm text-yellow-700 dark:text-yellow-300';
            } else {
                content.classList.add('border-blue-500');
                icon.innerHTML = '<i class="fas fa-info-circle text-blue-500"></i>';
                titleEl.className = 'text-sm font-semibold mb-1 text-blue-800 dark:text-blue-200';
                messageEl.className = 'text-sm text-blue-700 dark:text-blue-300';
            }
            
            titleEl.textContent = title;
            messageEl.textContent = message;
            popup.classList.remove('hidden');
            
            // Tự động đóng sau 5 giây
            setTimeout(() => {
                closeNotification();
            }, 5000);
        }
        
        // Hàm đóng notification
        function closeNotification() {
            const popup = document.getElementById('notificationPopup');
            popup.classList.add('hidden');
        }
        
        // Form validation
        form.addEventListener('submit', function(e) {
            // Nếu đang submit (đã validate và đang submit programmatically), cho phép submit
            if (isSubmitting) {
                // Không preventDefault, cho phép form submit
                return true;
            }

            // Reset error styling
            document.querySelectorAll('input, select, textarea').forEach(element => {
                element.classList.remove('border-red-500');
            });

            let isValid = true;
            let errorMessages = [];
            let firstErrorField = null;

            // Validate Required Fields
            const requiredFields = [
                { name: 'PhoneNumber', label: 'Số điện thoại', element: document.querySelector('input[name="PhoneNumber"]') },
                { name: 'Gender', label: 'Giới tính', element: document.querySelector('select[name="Gender"]') },
                { name: 'DateOfBirth', label: 'Ngày sinh', element: document.querySelector('input[name="DateOfBirth"]') },
                { name: 'Height', label: 'Chiều cao', element: document.querySelector('input[name="Height"]') },
                { name: 'Location', label: 'Địa chỉ hiện tại', element: document.querySelector('input[name="Location"]') },
                { name: 'Hometown', label: 'Quê quán', element: document.querySelector('input[name="Hometown"]') },
                { name: 'Interests', label: 'Sở thích', element: document.querySelector('input[name="Interests"]') },
                { name: 'PersonalityText', label: 'Mô tả tính cách', element: document.querySelector('textarea[name="PersonalityText"]') }
            ];

            // Kiểm tra các trường bắt buộc
            requiredFields.forEach(field => {
                if (field.element) {
                    const value = field.element.value ? field.element.value.trim() : '';
                    if (!value) {
                        errorMessages.push(`${field.label} là bắt buộc`);
                        field.element.classList.add('border-red-500');
                        isValid = false;
                        if (!firstErrorField) {
                            firstErrorField = field.element;
                        }
                    }
                }
            });

            // Validate Phone Number Format (nếu đã có giá trị)
            const phone = document.querySelector('input[name="PhoneNumber"]');
            if (phone && phone.value && phone.value.trim()) {
                const phonePattern = /^[0-9+\-\s()]{10,15}$/;
                if (!phonePattern.test(phone.value.trim())) {
                    errorMessages.push('Số điện thoại không hợp lệ (phải từ 10-15 số)');
                    phone.classList.add('border-red-500');
                    isValid = false;
                    if (!firstErrorField) {
                        firstErrorField = phone;
                    }
                }
            }

            // Validate Date of Birth (must be at least 18 years old) - nếu đã có giá trị
            const dob = document.querySelector('input[name="DateOfBirth"]');
            if (dob && dob.value) {
                const birthDate = new Date(dob.value);
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const monthDiff = today.getMonth() - birthDate.getMonth();
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                
                if (age < 18) {
                    errorMessages.push('Bạn phải từ 18 tuổi trở lên');
                    dob.classList.add('border-red-500');
                    isValid = false;
                    if (!firstErrorField) {
                        firstErrorField = dob;
                    }
                }
            }

            // Validate Height (nếu đã có giá trị)
            const height = document.querySelector('input[name="Height"]');
            if (height && height.value) {
                const heightValue = parseInt(height.value);
                if (isNaN(heightValue) || heightValue < 100 || heightValue > 250) {
                    errorMessages.push('Chiều cao phải từ 100 đến 250 cm');
                    height.classList.add('border-red-500');
                    isValid = false;
                    if (!firstErrorField) {
                        firstErrorField = height;
                    }
                }
            }

            // Nếu có lỗi, prevent submit và hiển thị thông báo
            if (!isValid) {
                e.preventDefault();
                e.stopPropagation();
                
                // Scroll đến field đầu tiên bị lỗi
                if (firstErrorField) {
                    firstErrorField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstErrorField.focus();
                }
                
                // Hiển thị thông báo lỗi bằng popup
                showNotification('error', 'Lỗi xác thực', errorMessages.join('\n'));
                return false;
            }
            
            // Nếu validation thành công, hiển thị loading và submit form
            if (isValid && !submitBtn.disabled) {
                // Đánh dấu đang submit
                isSubmitting = true;
                
                // Hiển thị loading overlay
                loadingOverlay.classList.remove('hidden');
                
                // Disable nút submit
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                submitText.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Đang xử lý...';
                
                // Sử dụng setTimeout để đảm bảo UI được cập nhật trước khi submit
                setTimeout(() => {
                    // Submit form programmatically
                    form.submit();
                }, 100);
                
                // PreventDefault để kiểm soát submit
                e.preventDefault();
                return false;
            }
            
            // Nếu có lỗi, đã preventDefault ở trên
            return false;
        });

        // Clear error styling on input
        document.querySelectorAll('input, select, textarea').forEach(element => {
            element.addEventListener('input', function() {
                this.classList.remove('border-red-500');
            });
        });
    </script>
}
