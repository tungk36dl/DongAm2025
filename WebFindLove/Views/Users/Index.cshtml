@model IEnumerable<WebFindLove.Models.User>

@{
    ViewData["Title"] = "Quản Lý Người Dùng";
    var search = ViewBag.Search as WebFindLove.Models.Services.UserService.Dto.UserSearch;
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var totalPages = (int)(ViewBag.TotalPages ?? 0);
}

<div class="mb-6">
    <div class="flex justify-between items-center mb-6 animate-fadeIn">
        <div>
            <h1 class="text-3xl font-bold text-gray-800 dark:text-white bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">
                <i class="fas fa-users text-primary mr-2 animate-pulse"></i>Quản Lý Người Dùng
            </h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">Quản lý tất cả người dùng trong hệ thống</p>
        </div>
        <a asp-action="Create" class="bg-gradient-to-r from-primary to-secondary text-white px-6 py-3 rounded-lg hover:shadow-xl transition-all duration-300 transform hover:scale-105 font-medium relative overflow-hidden group">
            <span class="relative z-10 flex items-center">
                <i class="fas fa-plus mr-2 group-hover:animate-bounce"></i>Thêm Người Dùng Mới
            </span>
            <span class="absolute inset-0 bg-gradient-to-r from-secondary to-primary opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
        </a>
    </div>

    <!-- Search and Filter Section -->
    <div class="bg-white/95 dark:bg-gray-800/95 backdrop-blur-md rounded-xl shadow-xl p-6 mb-6 border border-gray-200/50 dark:border-gray-700/50 animate-scaleIn">
        <form method="get" asp-action="Index" class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                    <i class="fas fa-search mr-1"></i>Tìm Kiếm
                </label>
                <input type="text" 
                       name="Keyword" 
                       value="@search?.Keyword"
                       placeholder="Tên đăng nhập, Email hoặc Họ tên" 
                       class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white" />
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                    <i class="fas fa-user-shield mr-1"></i>Vai Trò
                </label>
                <select name="Role" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    <option value="">Tất Cả Vai Trò</option>
                    <option value="Admin" selected="@(search?.Role == "Admin")">Quản Trị Viên</option>
                    <!-- <option value="NhanVien" selected="@(search?.Role == "NhanVien")">Nhân Viên</option> -->
                    <option value="User" selected="@(search?.Role == "User")">Người Dùng</option>
                </select>
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                    <i class="fas fa-toggle-on mr-1"></i>Trạng Thái
                </label>
                <select name="IsActive" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    <option value="">Tất Cả Trạng Thái</option>
                    <option value="true" selected="@(search?.IsActive == true)">Hoạt Động</option>
                    <option value="false" selected="@(search?.IsActive == false)">Không Hoạt Động</option>
                </select>
            </div>

            <div>
                <label class="block text-gray-700 dark:text-gray-300 font-semibold mb-2 text-sm">
                    <i class="fas fa-list-ol mr-1"></i>Số Lượng/Trang
                </label>
                <select name="PageSize" class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white">
                    <option value="10" selected="@(pageSize == 10)">10</option>
                    <option value="20" selected="@(pageSize == 20)">20</option>
                    <option value="50" selected="@(pageSize == 50)">50</option>
                    <option value="100" selected="@(pageSize == 100)">100</option>
                </select>
            </div>

            <div class="flex items-end">
                <button type="submit" class="w-full bg-primary text-white px-6 py-2 rounded-lg hover:bg-pink-600 transition-all duration-300 transform hover:scale-105 font-medium shadow-md hover:shadow-lg">
                    <i class="fas fa-filter mr-2"></i>Lọc
                </button>
            </div>
            
            <!-- Hidden field to preserve page when filtering -->
            <input type="hidden" name="Page" value="1" />
        </form>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
    {
        <div class="bg-red-100 dark:bg-red-900 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-200 px-4 py-3 rounded-lg mb-4">
            <i class="fas fa-exclamation-circle mr-2"></i>
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- Users Table -->
    <div class="bg-white/95 dark:bg-gray-800/95 backdrop-blur-md rounded-xl shadow-xl overflow-hidden border border-gray-200/50 dark:border-gray-700/50 animate-fadeIn">
        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Thông Tin Người Dùng
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Email
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Vai Trò
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Trạng Thái
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Ngày Tạo
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                                Hành Động
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
                        @foreach (var user in Model)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 transition-all duration-300 transform hover:scale-[1.01]">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-10 w-10">
                                            @if (!string.IsNullOrEmpty(user.Avatar))
                                            {
                                                <img src="@user.Avatar" alt="@user.UserName" 
                                                     class="h-10 w-10 rounded-full object-cover border-2 border-primary" 
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div class="h-10 w-10 rounded-full bg-gradient-to-r from-primary to-secondary flex items-center justify-center text-white font-bold" style="display: none;">
                                                    @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="h-10 w-10 rounded-full bg-gradient-to-r from-primary to-secondary flex items-center justify-center text-white font-bold">
                                                    @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                                </div>
                                            }
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-gray-900 dark:text-white">@user.UserName</div>
                                            <div class="text-sm text-gray-500 dark:text-gray-400">@user.FullName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900 dark:text-white">@user.Email</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full 
                                        @(user.RoleName == "Admin" ? "bg-red-100 text-red-800" : 
                                          user.RoleName == "NhanVien" ? "bg-blue-100 text-blue-800" : 
                                          "bg-green-100 text-green-800")">
                                        <i class="fas fa-user-shield mr-1"></i>@(user.RoleName ?? "User")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (user.IsActive)
                                    {
                                        <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                            <i class="fas fa-check-circle mr-1"></i>Hoạt Động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                            <i class="fas fa-times-circle mr-1"></i>Không Hoạt Động
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                    @user.CreatedAt?.ToString("dd/MM/yyyy")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="text-blue-600 hover:text-blue-900 mr-3 transition-all duration-300 transform hover:scale-125 inline-block" title="Xem Chi Tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="text-green-600 hover:text-green-900 mr-3 transition-all duration-300 transform hover:scale-125 inline-block" title="Chỉnh Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="text-red-600 hover:text-red-900 transition-all duration-300 transform hover:scale-125 inline-block" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="bg-gray-50 dark:bg-gray-700 px-6 py-4 border-t border-gray-200 dark:border-gray-600">
                    <div class="flex items-center justify-between">
                        <div class="text-sm text-gray-700 dark:text-gray-300">
                            Hiển thị <span class="font-semibold">@((currentPage - 1) * pageSize + 1)</span> đến 
                            <span class="font-semibold">@(Math.Min(currentPage * pageSize, totalCount))</span> trong tổng số 
                            <span class="font-semibold">@totalCount</span> người dùng
                        </div>
                        <div class="flex items-center space-x-2">
                            @{
                                Func<int, Dictionary<string, string>> getRouteValues = (page) => {
                                    var values = new Dictionary<string, string>();
                                    if (!string.IsNullOrEmpty(search?.Keyword))
                                        values["Keyword"] = search.Keyword;
                                    if (!string.IsNullOrEmpty(search?.Role))
                                        values["Role"] = search.Role;
                                    if (search?.IsActive != null && search.IsActive.HasValue)
                                        values["IsActive"] = search.IsActive.Value.ToString();
                                    values["PageSize"] = pageSize.ToString();
                                    values["Page"] = page.ToString();
                                    return values;
                                };
                                
                                var startPage = Math.Max(1, currentPage - 2);
                                var endPage = Math.Min(totalPages, currentPage + 2);
                            }
                            
                            @if (currentPage > 1)
                            {
                                <a href="@Url.Action("Index", getRouteValues(currentPage - 1))" 
                                   class="px-4 py-2 bg-white dark:bg-gray-600 text-gray-700 dark:text-white rounded-lg hover:bg-gray-100 dark:hover:bg-gray-500 transition border border-gray-300 dark:border-gray-500">
                                    <i class="fas fa-chevron-left"></i> Trang trước
                                </a>
                            }
                            
                            @if (startPage > 1)
                            {
                                <a href="@Url.Action("Index", getRouteValues(1))" 
                                   class="px-3 py-2 bg-white dark:bg-gray-600 text-gray-700 dark:text-white rounded-lg hover:bg-gray-100 dark:hover:bg-gray-500 transition border border-gray-300 dark:border-gray-500">1</a>
                                @if (startPage > 2)
                                {
                                    <span class="px-2 text-gray-500">...</span>
                                }
                            }
                            
                            @for (int i = startPage; i <= endPage; i++)
                            {
                                if (i == currentPage)
                                {
                                    <span class="px-4 py-2 bg-primary text-white rounded-lg font-semibold">@i</span>
                                }
                                else
                                {
                                    <a href="@Url.Action("Index", getRouteValues(i))" 
                                       class="px-4 py-2 bg-white dark:bg-gray-600 text-gray-700 dark:text-white rounded-lg hover:bg-gray-100 dark:hover:bg-gray-500 transition border border-gray-300 dark:border-gray-500">@i</a>
                                }
                            }
                            
                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <span class="px-2 text-gray-500">...</span>
                                }
                                <a href="@Url.Action("Index", getRouteValues(totalPages))" 
                                   class="px-3 py-2 bg-white dark:bg-gray-600 text-gray-700 dark:text-white rounded-lg hover:bg-gray-100 dark:hover:bg-gray-500 transition border border-gray-300 dark:border-gray-500">@totalPages</a>
                            }
                            
                            @if (currentPage < totalPages)
                            {
                                <a href="@Url.Action("Index", getRouteValues(currentPage + 1))" 
                                   class="px-4 py-2 bg-white dark:bg-gray-600 text-gray-700 dark:text-white rounded-lg hover:bg-gray-100 dark:hover:bg-gray-500 transition border border-gray-300 dark:border-gray-500">
                                    Trang sau <i class="fas fa-chevron-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (totalCount > 0)
            {
                <div class="bg-gray-50 dark:bg-gray-700 px-6 py-4 border-t border-gray-200 dark:border-gray-600">
                    <div class="text-sm text-gray-700 dark:text-gray-300 text-center">
                        Hiển thị tất cả <span class="font-semibold">@totalCount</span> người dùng
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-12">
                <i class="fas fa-users text-6xl text-gray-300 mb-4"></i>
                <h3 class="text-xl font-semibold text-gray-600 dark:text-gray-400 mb-2">Không Tìm Thấy Người Dùng</h3>
                <p class="text-gray-500 dark:text-gray-500">Thử điều chỉnh tiêu chí tìm kiếm hoặc bộ lọc</p>
            </div>
        }
    </div>
</div>
