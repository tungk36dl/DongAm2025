@model WebFindLove.Models.User

@{
    ViewData["Title"] = "Xóa Người Dùng";
}

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a asp-action="Index" class="text-primary hover:text-pink-600 font-medium">
            <i class="fas fa-arrow-left mr-2"></i>Quay Lại Danh Sách
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-8">
        <div class="text-center mb-8">
            <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-red-100 mb-4">
                <i class="fas fa-exclamation-triangle text-4xl text-red-600"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-2">Xóa Người Dùng</h1>
            <p class="text-gray-600 dark:text-gray-400">Bạn có chắc chắn muốn xóa người dùng này?</p>
        </div>

        <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-6 mb-6">
            <div class="flex items-center mb-6">
                <div class="h-16 w-16 rounded-full bg-gradient-to-r from-primary to-secondary flex items-center justify-center text-white text-2xl font-bold">
                    @(Model.UserName?.Substring(0, 1).ToUpper() ?? "U")
                </div>
                <div class="ml-4">
                    <h3 class="text-xl font-bold text-gray-800 dark:text-white">@Model.UserName</h3>
                    <p class="text-gray-600 dark:text-gray-400">@Model.Email</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-gray-200 dark:border-gray-600 pt-4">
                <div>
                    <label class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase">Họ và Tên</label>
                    <p class="mt-1 text-gray-800 dark:text-white">@(Model.FullName ?? "Chưa cập nhật")</p>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase">Vai Trò</label>
                    <p class="mt-1">
                        <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full 
                            @(Model.RoleName == "Admin" ? "bg-red-100 text-red-800" : 
                              Model.RoleName == "NhanVien" ? "bg-blue-100 text-blue-800" : 
                              "bg-green-100 text-green-800")">
                            @(Model.RoleName ?? "User")
                        </span>
                    </p>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase">Trạng Thái</label>
                    <p class="mt-1">
                        @if (Model.IsActive)
                        {
                            <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-green-100 text-green-800">
                                <i class="fas fa-check-circle mr-1"></i>Hoạt Động
                            </span>
                        }
                        else
                        {
                            <span class="px-3 py-1 inline-flex text-sm font-semibold rounded-full bg-red-100 text-red-800">
                                <i class="fas fa-times-circle mr-1"></i>Không Hoạt Động
                            </span>
                        }
                    </p>
                </div>
                <div>
                    <label class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase">Ngày Tạo</label>
                    <p class="mt-1 text-gray-800 dark:text-white">@Model.CreatedAt?.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
        </div>

        <div class="bg-red-50 dark:bg-red-900 border-l-4 border-red-500 p-4 mb-6 rounded">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-circle text-red-500"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-red-700 dark:text-red-200">
                        <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Tất cả dữ liệu người dùng sẽ bị xóa vĩnh viễn.
                    </p>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="flex justify-end space-x-4">
                <a asp-action="Index" class="px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 transition font-medium">
                    <i class="fas fa-times mr-2"></i>Hủy
                </a>
                <button type="submit" class="bg-red-600 text-white px-6 py-3 rounded-lg hover:bg-red-700 transition font-medium">
                    <i class="fas fa-trash mr-2"></i>Xác Nhận Xóa
                </button>
            </div>
        </form>
    </div>
</div>
