@{
    ViewData["Title"] = "Ghép Đôi";
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8 text-center animate-fadeIn">
        <h1 class="text-4xl font-bold text-gray-800 dark:text-gray-100 mb-2 bg-clip-text text-transparent bg-gradient-to-r from-primary to-secondary">
            <i class="fas fa-heart text-pink-500 mr-3 animate-pulse"></i>Ghép Đôi Thông Minh
        </h1>
        <p class="text-gray-600 dark:text-gray-400 text-lg">Tìm người phù hợp với bạn bằng công nghệ AI</p>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6 flex items-center justify-between">
            <div class="flex items-center">
                <i class="fas fa-check-circle mr-2"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-green-700 hover:text-green-900">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6 flex items-center justify-between">
            <div class="flex items-center">
                <i class="fas fa-exclamation-circle mr-2"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-red-700 hover:text-red-900">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    <!-- Stats Card -->
    <div class="max-w-4xl mx-auto mb-8 animate-scaleIn">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl shadow-2xl p-6 text-white relative overflow-hidden">
            <div class="absolute inset-0 opacity-20">
                <div class="absolute top-0 right-0 w-32 h-32 bg-white rounded-full -mr-16 -mt-16"></div>
                <div class="absolute bottom-0 left-0 w-24 h-24 bg-white rounded-full -ml-12 -mb-12"></div>
            </div>
            <div class="flex items-center justify-between relative z-10">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 bg-white bg-opacity-20 backdrop-blur-sm rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110">
                        <i class="fas fa-users text-3xl"></i>
                    </div>
                    <div>
                        <p class="text-blue-100 text-sm mb-1">Người Phù Hợp Hiện Có</p>
                        <p class="text-3xl font-bold drop-shadow-lg" id="match-count">--</p>
                    </div>
                </div>
                <a asp-controller="MatchResults" asp-action="Index"
                   class="bg-white text-blue-600 px-6 py-3 rounded-lg font-bold hover:bg-blue-50 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center gap-2">
                    <i class="fas fa-list"></i>
                    <span>Xem Danh Sách Đã Ghép Đôi</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <!-- Option 1: Tìm người phù hợp với mình -->
        <div class="bg-gradient-to-br from-pink-500 to-red-500 rounded-xl shadow-xl overflow-hidden transform transition-all duration-300 hover:scale-105 hover:shadow-2xl border border-white/20 relative group">
            <div class="p-8 text-white">
                <div class="text-center mb-6">
                    <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-search text-5xl"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-2">Tìm Người Phù Hợp</h2>
                    <p class="text-pink-100">Khám phá những người phù hợp với sở thích của bạn</p>
                </div>

                <div class="space-y-3 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Tìm kiếm dựa trên sở thích và tính cách của bạn</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Điểm số tương thích được tính bằng AI</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Nhận gợi ý về những người phù hợp nhất</p>
                    </div>
                </div>

                <a asp-action="FindMatches" id="btn-find-matches" class="block w-full bg-white text-pink-600 text-center py-4 rounded-lg font-bold hover:bg-pink-50 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl relative overflow-hidden group">
                    <span class="relative z-10 flex items-center justify-center">
                        <i class="fas fa-heart mr-2 group-hover:animate-pulse"></i>Bắt Đầu Tìm Kiếm
                    </span>
                    <span class="absolute inset-0 bg-gradient-to-r from-pink-500/10 to-red-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                </a>
            </div>
        </div>

        <!-- Option 2: Tìm người phù hợp hai chiều -->
        <div class="bg-gradient-to-br from-purple-500 to-indigo-600 rounded-xl shadow-xl overflow-hidden transform transition-all duration-300 hover:scale-105 hover:shadow-2xl border border-white/20 relative group">
            <div class="p-8 text-white">
                <div class="text-center mb-6">
                    <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-heart-circle text-5xl"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-2">Người Phù Hợp Hai Chiều</h2>
                    <p class="text-purple-100">Tìm những người cũng quan tâm đến bạn</p>
                </div>

                <div class="space-y-3 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Những người cũng chọn bạn là người phù hợp</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Tương thích cao hơn về cả hai phía</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Cơ hội kết nối cao hơn</p>
                    </div>
                </div>

                <a asp-action="MutualMatches" id="btn-mutual-matches" class="block w-full bg-white text-purple-600 text-center py-4 rounded-lg font-bold hover:bg-purple-50 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl relative overflow-hidden group">
                    <span class="relative z-10 flex items-center justify-center">
                        <i class="fas fa-handshake mr-2 group-hover:animate-bounce"></i>Xem Kết Nối Hai Chiều
                    </span>
                    <span class="absolute inset-0 bg-gradient-to-r from-purple-500/10 to-indigo-600/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></span>
                </a>
            </div>
        </div>
    </div>

    <!-- Info Section -->
    <div class="mt-12 max-w-4xl mx-auto animate-fadeIn">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-xl p-8 border border-gray-200 dark:border-gray-700">
            <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100 mb-4 text-center bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-purple-500">
                <i class="fas fa-info-circle text-blue-500 mr-2 animate-pulse"></i>
                Cách Hoạt Động
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="text-center group">
                    <div class="w-16 h-16 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110">
                        <i class="fas fa-user-edit text-blue-600 dark:text-blue-400 text-2xl group-hover:animate-bounce"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">1. Hoàn Thiện Hồ Sơ</h4>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Cập nhật thông tin cá nhân và thiết lập sở thích tìm kiếm</p>
                </div>

                <div class="text-center group">
                    <div class="w-16 h-16 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110">
                        <i class="fas fa-robot text-purple-600 dark:text-purple-400 text-2xl group-hover:animate-bounce"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">2. AI Phân Tích</h4>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Hệ thống AI phân tích và tính toán độ tương thích</p>
                </div>

                <div class="text-center group">
                    <div class="w-16 h-16 bg-pink-100 dark:bg-pink-900/30 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110">
                        <i class="fas fa-heart text-pink-600 dark:text-pink-400 text-2xl group-hover:animate-pulse"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">3. Kết Nối</h4>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">Nhắn tin và kết nối với những người phù hợp</p>
                </div>
            </div>

            <div class="mt-8 text-center">
                <p class="text-gray-600 mb-4">
                    <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>
                    <strong>Mẹo:</strong> Cập nhật đầy đủ thông tin và sở thích để có kết quả tốt nhất!
                </p>
                <div class="flex gap-4 justify-center">
                    <a asp-controller="Users" asp-action="EditProfile" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-all duration-300 font-medium hover:underline transform hover:scale-105">
                        <i class="fas fa-edit mr-1"></i>Chỉnh Sửa Hồ Sơ
                    </a>
                    <a asp-controller="UserPreferences" asp-action="Edit" class="text-purple-600 dark:text-purple-400 hover:text-purple-800 dark:hover:text-purple-300 transition-all duration-300 font-medium hover:underline transform hover:scale-105">
                        <i class="fas fa-sliders-h mr-1"></i>Thiết Lập Sở Thích
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Global Loading Overlay for matching actions -->
<div id="matching-loading-overlay" class="fixed inset-0 bg-white/90 dark:bg-gray-900/90 backdrop-blur-md z-[1000] hidden animate-fadeIn">
    <div class="w-full h-full flex flex-col items-center justify-center gap-4">
        <div class="relative">
            <i class="fas fa-heart text-pink-500 text-5xl animate-bounce drop-shadow-lg"></i>
            <div class="absolute inset-0 bg-pink-500 rounded-full blur-xl opacity-50 animate-pulse"></div>
        </div>
        <div class="flex items-center gap-3 text-gray-700 dark:text-gray-200 bg-white/80 dark:bg-gray-800/80 px-6 py-3 rounded-full shadow-xl">
            <i class="fas fa-spinner fa-spin text-2xl text-primary"></i>
            <span class="font-semibold">Đang ghép đôi bằng AI, vui lòng chờ...</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load match count on page load
        $(document).ready(function() {
            loadMatchCount();
            bindMatchingButtons();
        });

        // Load current match count
        function loadMatchCount() {
            $.ajax({
                url: '@Url.Action("GetMatchCount", "Matching")',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        $('#match-count').text(response.count);
                        $('#match-count').removeClass('text-red-500').addClass('text-white');
                    } else {
                        $('#match-count').text('0');
                        $('#match-count').removeClass('text-white').addClass('text-red-200');
                    }
                },
                error: function() {
                    $('#match-count').text('--');
                }
            });
        }

        // (Removed refresh action) Now using link to MatchResults/Index to view matched users

        // Show/hide global loading overlay
        function showGlobalLoading(message) {
            const overlay = document.getElementById('matching-loading-overlay');
            if (!overlay) return;
            if (message) {
                const span = overlay.querySelector('span');
                if (span) span.textContent = message;
            }
            overlay.classList.remove('hidden');
        }

        function hideGlobalLoading() {
            const overlay = document.getElementById('matching-loading-overlay');
            if (!overlay) return;
            overlay.classList.add('hidden');
        }

        // Bind matching action buttons to show loading immediately on click
        function bindMatchingButtons() {
            const btnOne = document.getElementById('btn-find-matches');
            const btnTwo = document.getElementById('btn-mutual-matches');

            [btnOne, btnTwo].forEach(btn => {
                if (!btn) return;
                btn.addEventListener('click', function() {
                    // Small timeout ensures DOM paints the overlay before navigation
                    showGlobalLoading('Đang ghép đôi bằng AI, vui lòng chờ...');
                });
            });
        }

        // Show notification helper
        function showNotification(type, message) {
            const bgColor = type === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700';
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
            
            const notification = $(`
                <div class="${bgColor} border px-4 py-3 rounded-lg mb-6 flex items-center justify-between" role="alert">
                    <div class="flex items-center">
                        <i class="fas ${icon} mr-2"></i>
                        <span>${message}</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="${type === 'success' ? 'text-green-700 hover:text-green-900' : 'text-red-700 hover:text-red-900'}">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `);
            
            $('.container').prepend(notification);
            
            // Auto remove after 5 seconds
            setTimeout(function() {
                notification.fadeOut(function() {
                    $(this).remove();
                });
            }, 5000);
        }
    </script>
}

