@{
    ViewData["Title"] = "Ghép Đôi";
}

<div class="container mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8 text-center">
        <h1 class="text-4xl font-bold text-gray-800 mb-2">
            <i class="fas fa-heart text-pink-500 mr-3"></i>Ghép Đôi Thông Minh
        </h1>
        <p class="text-gray-600 text-lg">Tìm người phù hợp với bạn bằng công nghệ AI</p>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-6 flex items-center justify-between">
            <div class="flex items-center">
                <i class="fas fa-check-circle mr-2"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-green-700 hover:text-green-900">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6 flex items-center justify-between">
            <div class="flex items-center">
                <i class="fas fa-exclamation-circle mr-2"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-red-700 hover:text-red-900">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    <!-- Stats Card -->
    <div class="max-w-4xl mx-auto mb-8">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-lg shadow-lg p-6 text-white">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 bg-white bg-opacity-20 rounded-full flex items-center justify-center">
                        <i class="fas fa-users text-3xl"></i>
                    </div>
                    <div>
                        <p class="text-blue-100 text-sm mb-1">Người Phù Hợp Hiện Có</p>
                        <p class="text-3xl font-bold" id="match-count">--</p>
                    </div>
                </div>
                <form asp-action="RefreshMatches" method="post" id="refresh-form" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="refresh-btn" 
                            class="bg-white text-blue-600 px-6 py-3 rounded-lg font-bold hover:bg-blue-50 transition shadow-lg flex items-center gap-2">
                        <i class="fas fa-sync-alt" id="refresh-icon"></i>
                        <span>Cập Nhật Ngay</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <!-- Option 1: Tìm người phù hợp với mình -->
        <div class="bg-gradient-to-br from-pink-500 to-red-500 rounded-lg shadow-lg overflow-hidden transform transition hover:scale-105">
            <div class="p-8 text-white">
                <div class="text-center mb-6">
                    <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-search text-5xl"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-2">Tìm Người Phù Hợp</h2>
                    <p class="text-pink-100">Khám phá những người phù hợp với sở thích của bạn</p>
                </div>

                <div class="space-y-3 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Tìm kiếm dựa trên sở thích và tính cách của bạn</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Điểm số tương thích được tính bằng AI</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Nhận gợi ý về những người phù hợp nhất</p>
                    </div>
                </div>

                <a asp-action="FindMatches" class="block w-full bg-white text-pink-600 text-center py-4 rounded-lg font-bold hover:bg-pink-50 transition shadow-lg">
                    <i class="fas fa-heart mr-2"></i>Bắt Đầu Tìm Kiếm
                </a>
            </div>
        </div>

        <!-- Option 2: Tìm người phù hợp hai chiều -->
        <div class="bg-gradient-to-br from-purple-500 to-indigo-600 rounded-lg shadow-lg overflow-hidden transform transition hover:scale-105">
            <div class="p-8 text-white">
                <div class="text-center mb-6">
                    <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-heart-circle text-5xl"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-2">Người Phù Hợp Hai Chiều</h2>
                    <p class="text-purple-100">Tìm những người cũng quan tâm đến bạn</p>
                </div>

                <div class="space-y-3 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Những người cũng chọn bạn là người phù hợp</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Tương thích cao hơn về cả hai phía</p>
                    </div>
                    <div class="flex items-start">
                        <i class="fas fa-check-circle mr-3 mt-1"></i>
                        <p class="text-sm">Cơ hội kết nối cao hơn</p>
                    </div>
                </div>

                <a asp-action="MutualMatches" class="block w-full bg-white text-purple-600 text-center py-4 rounded-lg font-bold hover:bg-purple-50 transition shadow-lg">
                    <i class="fas fa-handshake mr-2"></i>Xem Kết Nối Hai Chiều
                </a>
            </div>
        </div>
    </div>

    <!-- Info Section -->
    <div class="mt-12 max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-md p-8">
            <h3 class="text-2xl font-bold text-gray-800 mb-4 text-center">
                <i class="fas fa-info-circle text-blue-500 mr-2"></i>
                Cách Hoạt Động
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="text-center">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-user-edit text-blue-600 text-2xl"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 mb-2">1. Hoàn Thiện Hồ Sơ</h4>
                    <p class="text-gray-600 text-sm">Cập nhật thông tin cá nhân và thiết lập sở thích tìm kiếm</p>
                </div>

                <div class="text-center">
                    <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-robot text-purple-600 text-2xl"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 mb-2">2. AI Phân Tích</h4>
                    <p class="text-gray-600 text-sm">Hệ thống AI phân tích và tính toán độ tương thích</p>
                </div>

                <div class="text-center">
                    <div class="w-16 h-16 bg-pink-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-heart text-pink-600 text-2xl"></i>
                    </div>
                    <h4 class="font-semibold text-gray-800 mb-2">3. Kết Nối</h4>
                    <p class="text-gray-600 text-sm">Nhắn tin và kết nối với những người phù hợp</p>
                </div>
            </div>

            <div class="mt-8 text-center">
                <p class="text-gray-600 mb-4">
                    <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>
                    <strong>Mẹo:</strong> Cập nhật đầy đủ thông tin và sở thích để có kết quả tốt nhất!
                </p>
                <div class="flex gap-4 justify-center">
                    <a asp-controller="Users" asp-action="EditProfile" class="text-blue-600 hover:underline">
                        <i class="fas fa-edit mr-1"></i>Chỉnh Sửa Hồ Sơ
                    </a>
                    <a asp-controller="UserPreferences" asp-action="Edit" class="text-purple-600 hover:underline">
                        <i class="fas fa-sliders-h mr-1"></i>Thiết Lập Sở Thích
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load match count on page load
        $(document).ready(function() {
            loadMatchCount();
        });

        // Load current match count
        function loadMatchCount() {
            $.ajax({
                url: '@Url.Action("GetMatchCount", "Matching")',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        $('#match-count').text(response.count);
                        $('#match-count').removeClass('text-red-500').addClass('text-white');
                    } else {
                        $('#match-count').text('0');
                        $('#match-count').removeClass('text-white').addClass('text-red-200');
                    }
                },
                error: function() {
                    $('#match-count').text('--');
                }
            });
        }

        // Handle refresh form submission
        $('#refresh-form').on('submit', function(e) {
            e.preventDefault();
            
            const $btn = $('#refresh-btn');
            const $icon = $('#refresh-icon');
            const originalHtml = $btn.html();
            
            // Disable button and show loading state
            $btn.prop('disabled', true);
            $icon.addClass('fa-spin');
            $btn.find('span').text('Đang Cập Nhật...');
            
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        // Show success message
                        showNotification('success', response.message);
                        
                        // Reload match count
                        loadMatchCount();
                        
                        // Update button text temporarily
                        $btn.find('span').text('Thành Công!');
                        setTimeout(function() {
                            $btn.html(originalHtml);
                            $btn.prop('disabled', false);
                        }, 2000);
                    } else {
                        showNotification('error', response.message || 'Có lỗi xảy ra');
                        $btn.html(originalHtml);
                        $btn.prop('disabled', false);
                    }
                },
                error: function() {
                    showNotification('error', 'Không thể kết nối đến máy chủ');
                    $btn.html(originalHtml);
                    $btn.prop('disabled', false);
                }
            });
        });

        // Show notification helper
        function showNotification(type, message) {
            const bgColor = type === 'success' ? 'bg-green-100 border-green-400 text-green-700' : 'bg-red-100 border-red-400 text-red-700';
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
            
            const notification = $(`
                <div class="${bgColor} border px-4 py-3 rounded-lg mb-6 flex items-center justify-between" role="alert">
                    <div class="flex items-center">
                        <i class="fas ${icon} mr-2"></i>
                        <span>${message}</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="${type === 'success' ? 'text-green-700 hover:text-green-900' : 'text-red-700 hover:text-red-900'}">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `);
            
            $('.container').prepend(notification);
            
            // Auto remove after 5 seconds
            setTimeout(function() {
                notification.fadeOut(function() {
                    $(this).remove();
                });
            }, 5000);
        }
    </script>
}

