@{
    var currentUserIdString = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}

@if (isAuthenticated)
{
    <!-- CSRF Token for AJAX calls -->
    @Html.AntiForgeryToken()
    
    <!-- Chat Widget Button -->
    <div id="chatWidget" class="fixed bottom-6 right-6 z-50">
        <!-- Notification Badge -->
        <span id="chatNotificationBadge" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold rounded-full h-6 w-6 flex items-center justify-center z-55">0</span>
        
        <!-- Chat Button -->
        <button id="chatWidgetBtn" class="bg-gradient-to-br from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white rounded-full p-4 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 z-52">
            <i class="fas fa-comments text-2xl"></i>
        </button>

        <!-- Chat Popup -->
        <div id="chatPopup" class="hidden absolute bottom-20 right-0 w-96 bg-white rounded-lg shadow-2xl overflow-hidden border border-gray-200" style="height: 600px;">
            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-purple-600 text-white p-4 flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <i class="fas fa-comments text-xl"></i>
                    <h3 class="font-bold text-lg">Messages</h3>
                    <span id="unreadCountBadge" class="hidden bg-white text-blue-600 text-xs font-bold px-2 py-1 rounded-full">0</span>
                </div>
                <div class="flex gap-2">
                    <button id="refreshChatBtn" class="hover:bg-white/20 p-2 rounded-lg transition">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                    <button id="closeChatBtn" class="hover:bg-white/20 p-2 rounded-lg transition">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Content Area -->
            <div id="chatContent" class="h-full flex flex-col">
                <!-- Conversations List View -->
                <div id="conversationsView" class="flex-1 overflow-y-auto">
                    <div id="conversationsList" class="divide-y divide-gray-200">
                        <!-- Loading State -->
                        <div id="loadingState" class="flex items-center justify-center h-64">
                            <div class="text-center">
                                <i class="fas fa-spinner fa-spin text-4xl text-blue-600 mb-3"></i>
                                <p class="text-gray-500">Loading conversations...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Conversation Detail View -->
                <div id="conversationView" class="hidden flex-1 flex flex-col">
                    <!-- Conversation Header -->
                    <div class="border-b border-gray-200 p-3 flex items-center gap-3 bg-gray-50">
                        <button id="backToListBtn" class="text-gray-600 hover:text-gray-800 transition">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <div id="chatUserAvatar" class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold"></div>
                        <div class="flex-1">
                            <h4 id="chatUserName" class="font-semibold text-gray-800">User</h4>
                            <div class="flex items-center gap-2">
                                <span id="chatOnlineStatus" class="w-2 h-2 rounded-full bg-gray-400"></span>
                                <p class="text-xs text-gray-500" id="chatStatusText">Offline</p>
                            </div>
                        </div>
                    </div>

                    <!-- Messages Container -->
                    <div id="chatMessagesContainer" class="flex-1 overflow-y-auto p-4 bg-gray-50" style="max-height: 400px;">
                        <div id="chatMessagesList">
                            <!-- Messages will be loaded here -->
                        </div>
                        
                        <!-- Typing Indicator -->
                        <div id="chatTypingIndicator" class="hidden flex justify-start mb-2">
                            <div class="bg-gray-200 rounded-2xl rounded-bl-none px-3 py-2 shadow">
                                <div class="flex gap-1">
                                    <span class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay: 0ms;"></span>
                                    <span class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay: 150ms;"></span>
                                    <span class="w-2 h-2 bg-gray-500 rounded-full animate-bounce" style="animation-delay: 300ms;"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Send Message Form -->
                    <div class="border-t border-gray-200 p-3 bg-white">
                        <form id="chatMessageForm" class="flex gap-2 items-center relative">
                            <input type="hidden" id="chatReceiverId" value="" />
                            <button type="button" id="chatEmojiToggleBtn" title="Insert emoji" class="px-3 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-lg">😊</button>
                            <input type="text" 
                                   id="chatMessageInput"
                                   class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" 
                                   placeholder="Type a message..." 
                                   autocomplete="off">
                            <button type="submit" 
                                    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition flex items-center gap-2">
                                <i class="fas fa-paper-plane"></i>
                            </button>

                            <!-- Emoji Picker Container -->
                            <div id="chatEmojiPickerContainer" class="absolute bottom-12 left-0 z-50 hidden bg-white rounded-lg shadow-lg border border-gray-200">
                                <emoji-picker id="chatEmojiPicker"></emoji-picker>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Load SignalR if not already loaded -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/emoji-picker-element@1/index.js"></script>
    
    <script>
        (function() {
            // Chat Widget Controller
            const ChatWidget = {
                currentUserId: '@currentUserIdString',
                currentConversationUserId: null,
                connection: null,
                unreadCount: 0,

                // Initialize
                init() {
                    console.log('ChatWidget.init() called');
                    console.log('Current User ID:', this.currentUserId);
                    this.bindEvents();
                    this.startSignalR();
                    // Don't load conversations on init, only when popup is opened
                    console.log('ChatWidget initialized successfully');
                },

                // Bind UI Events
                bindEvents() {
                    const self = this;
                    
                    console.log('Binding chat widget events...');
                    
                    // Toggle chat popup
                    const chatBtn = document.getElementById('chatWidgetBtn');
                    if (chatBtn) {
                        console.log('Chat button found, binding click event');
                        chatBtn.addEventListener('click', function() {
                            console.log('Chat button clicked!');
                            self.togglePopup();
                        });
                    } else {
                        console.error('Chat button not found!');
                    }

                    // Close chat
                    const closeBtn = document.getElementById('closeChatBtn');
                    if (closeBtn) {
                        closeBtn.addEventListener('click', function() {
                            console.log('Close button clicked');
                            self.closePopup();
                        });
                    }

                    // Refresh conversations
                    const refreshBtn = document.getElementById('refreshChatBtn');
                    if (refreshBtn) {
                        refreshBtn.addEventListener('click', function() {
                            console.log('Refresh button clicked');
                            self.loadConversations();
                        });
                    }

                    // Back to list
                    const backBtn = document.getElementById('backToListBtn');
                    if (backBtn) {
                        backBtn.addEventListener('click', function() {
                            console.log('Back button clicked');
                            self.showConversationsList();
                        });
                    }

                    // Send message form
                    const messageForm = document.getElementById('chatMessageForm');
                    if (messageForm) {
                        messageForm.addEventListener('submit', function(e) {
                            e.preventDefault();
                            console.log('Sending message...');
                            self.sendMessage();
                        });
                    }

                    // Emoji toggle
                    const emojiToggle = document.getElementById('chatEmojiToggleBtn');
                    const emojiContainer = document.getElementById('chatEmojiPickerContainer');
                    const emojiPicker = document.getElementById('chatEmojiPicker');
                    const input = document.getElementById('chatMessageInput');

                    if (emojiToggle && emojiContainer) {
                        emojiToggle.addEventListener('click', function(e) {
                            e.preventDefault();
                            emojiContainer.classList.toggle('hidden');
                        });
                    }

                    if (emojiPicker && input) {
                        emojiPicker.addEventListener('emoji-click', function(event) {
                            const emoji = event.detail.unicode || event.detail.emoji?.unicode;
                            if (!emoji) return;
                            const start = input.selectionStart || input.value.length;
                            const end = input.selectionEnd || input.value.length;
                            const before = input.value.substring(0, start);
                            const after = input.value.substring(end);
                            input.value = before + emoji + after;
                            const caret = start + emoji.length;
                            input.focus();
                            input.setSelectionRange(caret, caret);
                        });
                    }

                    // Close emoji picker when clicking outside
                    document.addEventListener('click', function(e) {
                        if (!emojiContainer) return;
                        const target = e.target;
                        const clickedInside = emojiContainer.contains(target) || (emojiToggle && emojiToggle.contains(target));
                        if (!clickedInside) {
                            emojiContainer.classList.add('hidden');
                        }
                    });
                    
                    console.log('Events bound successfully');
                },

                // Toggle popup
                togglePopup() {
                    console.log('Toggle popup called');
                    const popup = document.getElementById('chatPopup');
                    if (!popup) {
                        console.error('Chat popup element not found!');
                        return;
                    }
                    
                    if (popup.classList.contains('hidden')) {
                        console.log('Opening popup...');
                        popup.classList.remove('hidden');
                        this.loadConversations();
                    } else {
                        console.log('Closing popup...');
                        popup.classList.add('hidden');
                    }
                },

                // Close popup
                closePopup() {
                    document.getElementById('chatPopup').classList.add('hidden');
                },

                // Load conversations
                async loadConversations() {
                    try {
                        const response = await fetch('/Messages/GetConversationsJson');
                        const data = await response.json();
                        
                        const loadingState = document.getElementById('loadingState');
                        loadingState?.classList.add('hidden');
                        
                        if (!data.success) {
                            console.error('Failed to load conversations:', data.message);
                            this.showEmptyState();
                            return;
                        }

                        // Update unread count
                        this.updateNotificationBadge(data.unreadCount);

                        // Display conversations
                        if (data.conversations && data.conversations.length > 0) {
                            this.displayConversations(data.conversations);
                        } else {
                            this.showEmptyState();
                        }
                    } catch (error) {
                        console.error('Error loading conversations:', error);
                        this.showEmptyState();
                    }
                },

                // Display conversations
                displayConversations(conversations) {
                    const container = document.getElementById('conversationsList');
                    const self = this;
                    
                    container.innerHTML = conversations.map(conv => {
                        const avatarHtml = conv.otherUserAvatar 
                            ? `<img src="${conv.otherUserAvatar}" alt="${self.escapeHtml(conv.otherUserName)}" class="w-12 h-12 rounded-full object-cover">`
                            : `<div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white font-bold">${conv.otherUserName.charAt(0).toUpperCase()}</div>`;
                        
                        const lastMessageTime = new Date(conv.lastMessageAt).toLocaleString('en-US', { 
                            month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                        });

                        const unreadBadge = conv.hasUnread 
                            ? `<span class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-full">${conv.unreadCount}</span>`
                            : '';

                        // Escape values for onclick
                        const escapedUserName = self.escapeHtml(conv.otherUserName).replace(/'/g, "\\'");
                        const escapedAvatar = (conv.otherUserAvatar || '').replace(/'/g, "\\'");

                        return `
                            <div class="p-4 hover:bg-gray-50 cursor-pointer border-b border-gray-100 ${conv.hasUnread ? 'bg-blue-50' : ''}" 
                                 onclick="window.ChatWidget.openConversation('${conv.otherUserId}', '${escapedUserName}', '${escapedAvatar}')">
                                <div class="flex items-center gap-3">
                                    ${avatarHtml}
                                    <div class="flex-1 min-w-0">
                                        <div class="flex justify-between items-start mb-1">
                                            <h4 class="font-semibold text-gray-800 truncate ${conv.hasUnread ? 'font-bold' : ''}">${self.escapeHtml(conv.otherUserName)}</h4>
                                            ${unreadBadge}
                                        </div>
                                        <p class="text-sm text-gray-600 truncate">${self.escapeHtml(conv.lastMessage || 'No messages yet')}</p>
                                        <p class="text-xs text-gray-400 mt-1">${lastMessageTime}</p>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
                },

                // Show empty state
                showEmptyState() {
                    const container = document.getElementById('conversationsList');
                    
                    container.innerHTML = `
                        <div class="p-6 text-center">
                            <i class="fas fa-comments text-gray-400 text-5xl mb-3"></i>
                            <h4 class="text-lg font-semibold text-gray-700 mb-2">No Messages Yet</h4>
                            <p class="text-gray-500 text-sm mb-4">Start a conversation from the messages page</p>
                            <a href="/Messages" class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">
                                Go to Messages
                            </a>
                        </div>
                    `;
                },

                // Show conversations list
                showConversationsList() {
                    document.getElementById('conversationsView').classList.remove('hidden');
                    document.getElementById('conversationView').classList.add('hidden');
                    this.currentConversationUserId = null;
                },

                // Open conversation
                openConversation(userId, userName, userAvatar) {
                    this.currentConversationUserId = userId;
                    
                    // Update UI
                    document.getElementById('conversationsView').classList.add('hidden');
                    document.getElementById('conversationView').classList.remove('hidden');
                    document.getElementById('chatUserName').textContent = userName;
                    document.getElementById('chatReceiverId').value = userId;
                    
                    // Set avatar
                    const avatarEl = document.getElementById('chatUserAvatar');
                    if (userAvatar) {
                        avatarEl.innerHTML = `<img src="${userAvatar}" alt="${userName}" class="w-10 h-10 rounded-full object-cover">`;
                    } else {
                        avatarEl.innerHTML = userName.charAt(0).toUpperCase();
                    }
                    
                    // Check and update online status
                    this.checkUserOnlineStatus(userId);
                    
                    // Load messages
                    this.loadMessages(userId);
                },

                // Load messages (matching format from Conversation.cshtml)
                async loadMessages(userId) {
                    console.log('Loading messages for user:', userId);
                    try {
                        const response = await fetch(`/Messages/GetMessagesJson?userId=${userId}`);
                        const data = await response.json();
                        
                        if (!data.success) {
                            console.error('Failed to load messages:', data.message);
                            return;
                        }

                        const messagesList = document.getElementById('chatMessagesList');
                        const otherUser = data.otherUser;
                        
                        if (data.messages && data.messages.length > 0) {
                            console.log('Loaded', data.messages.length, 'messages');
                            
                            messagesList.innerHTML = data.messages.map(msg => {
                                const isSentByMe = msg.isSentByMe;
                                const messageTime = new Date(msg.sentAt).toLocaleString('en-US', { 
                                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                                });

                                if (isSentByMe) {
                                    // My messages - right aligned, blue
                                    const readIcon = msg.isRead 
                                        ? '<span class="text-blue-600"><i class="fas fa-check-double"></i></span>' 
                                        : '<span class="text-gray-400"><i class="fas fa-check"></i></span>';
                                    
                                    return `
                                        <div class="flex justify-end mb-3 message-item">
                                            <div class="max-w-[75%]">
                                                <div class="bg-blue-600 text-white rounded-2xl rounded-br-none px-3 py-2 shadow">
                                                    <p class="text-sm break-words">${this.escapeHtml(msg.content)}</p>
                                                </div>
                                                <div class="flex justify-end gap-2 text-xs text-gray-500 mt-1 px-2">
                                                    <span>${messageTime}</span>
                                                    ${readIcon}
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                } else {
                                    // Other user's messages - left aligned, gray with avatar
                                    let avatarHtml = '';
                                    if (otherUser.avatar) {
                                        avatarHtml = `<img src="${otherUser.avatar}" alt="${otherUser.userName}" class="w-8 h-8 rounded-full object-cover mr-2 flex-shrink-0">`;
                                    } else {
                                        const initial = otherUser.userName ? otherUser.userName.charAt(0).toUpperCase() : '?';
                                        avatarHtml = `<div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-sm font-bold mr-2 flex-shrink-0">${initial}</div>`;
                                    }

                                    return `
                                        <div class="flex justify-start mb-3 message-item">
                                            ${avatarHtml}
                                            <div class="max-w-[75%]">
                                                <div class="bg-gray-200 text-gray-800 rounded-2xl rounded-bl-none px-3 py-2 shadow">
                                                    <p class="text-sm break-words">${this.escapeHtml(msg.content)}</p>
                                                </div>
                                                <div class="text-xs text-gray-500 mt-1 px-2">${messageTime}</div>
                                            </div>
                                        </div>
                                    `;
                                }
                            }).join('');
                        } else {
                            console.log('No messages found');
                            messagesList.innerHTML = `
                                <div class="text-center text-gray-500 py-8">
                                    <i class="fas fa-comments text-3xl mb-2"></i>
                                    <p class="text-sm">No messages yet. Start the conversation!</p>
                                </div>
                            `;
                        }

                        // Scroll to bottom
                        this.scrollToBottom();
                    } catch (error) {
                        console.error('Error loading messages:', error);
                        alert('Failed to load messages. Please try again.');
                    }
                },

                // Send message (improved with better error handling)
                async sendMessage() {
                    const input = document.getElementById('chatMessageInput');
                    const message = input.value.trim();
                    const receiverId = document.getElementById('chatReceiverId').value;

                    if (!message) {
                        console.log('Empty message, not sending');
                        return;
                    }

                    if (!receiverId) {
                        console.error('No receiver ID');
                        alert('Error: No receiver selected');
                        return;
                    }

                    console.log('Sending message to:', receiverId);

                    try {
                        // Get CSRF token
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        
                        const response = await fetch('/Messages/SendMessageJson', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token || ''
                            },
                            body: JSON.stringify({
                                receiverId: receiverId,
                                content: message
                            })
                        });

                        const data = await response.json();
                        console.log('Send response:', data);

                        if (data.success) {
                            // Add to UI immediately for instant feedback
                            this.addMessageToUI({
                                message: message,
                                senderId: this.currentUserId,
                                timestamp: new Date().toISOString(),
                                isSentByMe: true
                            });
                            
                            input.value = '';
                            input.focus();
                            this.scrollToBottom();
                            
                            console.log('Message sent successfully');
                        } else {
                            console.error('Failed to send:', data.message);
                            alert('Failed to send message: ' + data.message);
                        }
                    } catch (error) {
                        console.error('Error sending message:', error);
                        alert('Failed to send message. Please check your connection and try again.');
                    }
                },

                // Add message to UI (based on working Conversation.cshtml logic)
                addMessageToUI(data) {
                    const messagesList = document.getElementById('chatMessagesList');
                    if (!messagesList) {
                        console.error('Messages list not found');
                        return;
                    }

                    const isSentByMe = data.isSentByMe || data.senderId === this.currentUserId;
                    const messageTime = new Date(data.timestamp).toLocaleString('en-US', { 
                        month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' 
                    });

                    let messageHtml = '';

                    if (isSentByMe) {
                        // My message - align right, blue background
                        messageHtml = `
                            <div class="flex justify-end mb-3 message-item">
                                <div class="max-w-[75%]">
                                    <div class="bg-blue-600 text-white rounded-2xl rounded-br-none px-3 py-2 shadow">
                                        <p class="text-sm break-words">${this.escapeHtml(data.message)}</p>
                                    </div>
                                    <div class="flex justify-end gap-2 text-xs text-gray-500 mt-1 px-2">
                                        <span>${messageTime}</span>
                                        <span class="text-gray-400">
                                            <i class="fas fa-check"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        `;
                    } else {
                        // Other user's message - align left, gray background with avatar
                        let avatarHtml = '';
                        if (data.senderAvatar) {
                            avatarHtml = `<img src="${data.senderAvatar}" alt="${data.senderName}" class="w-8 h-8 rounded-full object-cover mr-2 flex-shrink-0">`;
                        } else {
                            const initial = data.senderName ? data.senderName.charAt(0).toUpperCase() : '?';
                            avatarHtml = `<div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-sm font-bold mr-2 flex-shrink-0">${initial}</div>`;
                        }

                        messageHtml = `
                            <div class="flex justify-start mb-3 message-item">
                                ${avatarHtml}
                                <div class="max-w-[75%]">
                                    <div class="bg-gray-200 text-gray-800 rounded-2xl rounded-bl-none px-3 py-2 shadow">
                                        <p class="text-sm break-words">${this.escapeHtml(data.message)}</p>
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1 px-2">${messageTime}</div>
                                </div>
                            </div>
                        `;
                    }

                    // Remove empty state if exists
                    const emptyState = messagesList.querySelector('.text-center');
                    if (emptyState) emptyState.remove();

                    messagesList.insertAdjacentHTML('beforeend', messageHtml);
                },

                // Scroll to bottom
                scrollToBottom() {
                    const container = document.getElementById('chatMessagesContainer');
                    if (container) {
                        container.scrollTop = container.scrollHeight;
                    }
                },

                // Escape HTML
                escapeHtml(text) {
                    const div = document.createElement('div');
                    div.textContent = text;
                    return div.innerHTML;
                },

                // Update notification badge
                updateNotificationBadge(count) {
                    this.unreadCount = count;
                    const badge = document.getElementById('chatNotificationBadge');
                    const unreadBadge = document.getElementById('unreadCountBadge');
                    
                    if (count > 0) {
                        badge?.classList.remove('hidden');
                        badge.textContent = count > 99 ? '99+' : count;
                        unreadBadge?.classList.remove('hidden');
                        unreadBadge.textContent = count;
                    } else {
                        badge?.classList.add('hidden');
                        unreadBadge?.classList.add('hidden');
                    }
                },

                // Update user online status in conversation view
                updateUserOnlineStatus(isOnline) {
                    const statusDot = document.getElementById('chatOnlineStatus');
                    const statusText = document.getElementById('chatStatusText');
                    
                    if (statusDot && statusText) {
                        if (isOnline) {
                            statusDot.classList.remove('bg-gray-400');
                            statusDot.classList.add('bg-green-500');
                            statusText.textContent = 'Online';
                            statusText.classList.remove('text-gray-500');
                            statusText.classList.add('text-green-600');
                        } else {
                            statusDot.classList.remove('bg-green-500');
                            statusDot.classList.add('bg-gray-400');
                            statusText.textContent = 'Offline';
                            statusText.classList.remove('text-green-600');
                            statusText.classList.add('text-gray-500');
                        }
                        console.log('User status updated:', isOnline ? 'Online' : 'Offline');
                    }
                },

                // Check and update user online status
                async checkUserOnlineStatus(userId) {
                    try {
                        if (this.connection && this.connection.state === 'Connected') {
                            // Call SignalR method to check online status
                            const isOnline = await this.connection.invoke('IsUserOnline', userId);
                            this.updateUserOnlineStatus(isOnline);
                            console.log('Initial online status for user', userId, ':', isOnline);
                        }
                    } catch (error) {
                        console.error('Error checking online status:', error);
                        // Default to offline if error
                        this.updateUserOnlineStatus(false);
                    }
                },

                // Start SignalR (based on working Conversation.cshtml logic)
                async startSignalR() {
                    const self = this;
                    
                    this.connection = new signalR.HubConnectionBuilder()
                        .withUrl("/chatHub")
                        .withAutomaticReconnect()
                        .build();

                    // Receive messages - SAME AS Conversation.cshtml
                    this.connection.on("ReceiveMessage", function (data) {
                        console.log('ChatWidget - Message received:', data);
                        
                        // If viewing the conversation with the sender, add to UI
                        if (self.currentConversationUserId === data.senderId) {
                            console.log('Adding message to current conversation');
                            self.addMessageToUI(data);
                            self.scrollToBottom();
                            
                            // Remove empty state if exists
                            const emptyState = document.querySelector('#chatMessagesList .text-center');
                            if (emptyState) emptyState.remove();
                        } else {
                            // Show notification for other conversations
                            console.log('Message from other user, updating badge');
                            self.updateNotificationBadge(self.unreadCount + 1);
                            
                            // Refresh conversations list if visible
                            const conversationsView = document.getElementById('conversationsView');
                            if (conversationsView && !conversationsView.classList.contains('hidden')) {
                                self.loadConversations();
                            }
                        }
                    });

                    // Listen for user status changes (online/offline)
                    this.connection.on("UserStatusChanged", function (data) {
                        console.log('User status changed:', data);
                        
                        // Update UI if we're viewing this user's conversation
                        if (self.currentConversationUserId === data.userId) {
                            self.updateUserOnlineStatus(data.isOnline);
                        }
                    });

                    // Connection events
                    this.connection.onreconnecting(() => {
                        console.log('SignalR Reconnecting...');
                    });

                    this.connection.onreconnected(() => {
                        console.log('SignalR Reconnected');
                    });

                    this.connection.onclose(() => {
                        console.log('SignalR Disconnected');
                    });

                    try {
                        await this.connection.start();
                        console.log('ChatWidget SignalR Connected');
                    } catch (err) {
                        console.error('SignalR Error:', err);
                        setTimeout(() => this.startSignalR(), 5000);
                    }
                }
            };

            // Make ChatWidget globally accessible
            window.ChatWidget = ChatWidget;

            // Initialize on DOM ready
            if (document.readyState === 'loading') {
                console.log('Waiting for DOM to load...');
                document.addEventListener('DOMContentLoaded', function() {
                    console.log('DOM loaded, initializing ChatWidget...');
                    ChatWidget.init();
                });
            } else {
                // DOM already loaded
                console.log('DOM already loaded, initializing ChatWidget immediately...');
                ChatWidget.init();
            }

            // Cleanup on page unload
            window.addEventListener('beforeunload', function() {
                if (ChatWidget.connection) {
                    ChatWidget.connection.stop();
                }
            });
        })();
    </script>
}

