<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebFindLove</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#ec4899',
                        secondary: '#8b5cf6',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50">
    <header class="bg-white shadow-md">
        <nav class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <a class="text-2xl font-bold text-primary hover:text-pink-600 transition" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-heart mr-2"></i>WebFindLove
                </a>
                
                <button class="lg:hidden text-gray-700 focus:outline-none" id="mobile-menu-button">
                    <i class="fas fa-bars text-2xl"></i>
                </button>

                <div class="hidden lg:flex items-center space-x-6" id="desktop-menu">
                    <a class="text-gray-700 hover:text-primary transition font-medium" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home mr-1"></i>Home
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="text-gray-700 hover:text-primary transition font-medium" asp-controller="Users" asp-action="Index">
                                <i class="fas fa-users mr-1"></i>Users
                            </a>
                            <a class="text-gray-700 hover:text-primary transition font-medium" asp-controller="Roles" asp-action="Index">
                                <i class="fas fa-user-shield mr-1"></i>Roles
                            </a>
                        }
                        <div class="relative group">
                            <button class="text-gray-700 hover:text-primary transition font-medium flex items-center">
                                <i class="fas fa-user-circle mr-1"></i>@User.Identity.Name
                                <i class="fas fa-chevron-down ml-1 text-xs"></i>
                            </button>
                            <div class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                <a class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-t-lg" asp-controller="Home" asp-action="Privacy">
                                    <i class="fas fa-user-cog mr-2"></i>Profile
                                </a>
                                <form method="post" asp-controller="Auth" asp-action="Logout" class="m-0">
                                    <button type="submit" class="w-full text-left px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-b-lg">
                                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="text-gray-700 hover:text-primary transition font-medium" asp-controller="Auth" asp-action="Login">
                            <i class="fas fa-sign-in-alt mr-1"></i>Login
                        </a>
                        <a class="bg-gradient-to-r from-primary to-secondary text-white px-6 py-2 rounded-full hover:shadow-lg transition font-medium" asp-controller="Auth" asp-action="Register">
                            <i class="fas fa-user-plus mr-1"></i>Register
                        </a>
                    }
                </div>
            </div>

            <!-- Mobile menu -->
            <div class="lg:hidden mt-4 hidden" id="mobile-menu">
                <div class="flex flex-col space-y-2">
                    <a class="text-gray-700 hover:text-primary transition font-medium py-2" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home mr-1"></i>Home
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="text-gray-700 hover:text-primary transition font-medium py-2" asp-controller="Users" asp-action="Index">
                                <i class="fas fa-users mr-1"></i>Users
                            </a>
                            <a class="text-gray-700 hover:text-primary transition font-medium py-2" asp-controller="Roles" asp-action="Index">
                                <i class="fas fa-user-shield mr-1"></i>Roles
                            </a>
                        }
                        <a class="text-gray-700 hover:text-primary transition font-medium py-2" asp-controller="Home" asp-action="Privacy">
                            <i class="fas fa-user-cog mr-1"></i>Profile
                        </a>
                        <form method="post" asp-controller="Auth" asp-action="Logout" class="m-0">
                            <button type="submit" class="text-left text-gray-700 hover:text-primary transition font-medium py-2">
                                <i class="fas fa-sign-out-alt mr-1"></i>Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="text-gray-700 hover:text-primary transition font-medium py-2" asp-controller="Auth" asp-action="Login">
                            <i class="fas fa-sign-in-alt mr-1"></i>Login
                        </a>
                        <a class="bg-gradient-to-r from-primary to-secondary text-white px-6 py-2 rounded-full hover:shadow-lg transition font-medium text-center" asp-controller="Auth" asp-action="Register">
                            <i class="fas fa-user-plus mr-1"></i>Register
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container mx-auto px-4 py-8 min-h-screen">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-4 flex items-center justify-between" role="alert">
                <div class="flex items-center">
                    <i class="fas fa-check-circle mr-2"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button onclick="this.parentElement.style.display='none'" class="text-green-700 hover:text-green-900">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-4 flex items-center justify-between" role="alert">
                <div class="flex items-center">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
                <button onclick="this.parentElement.style.display='none'" class="text-red-700 hover:text-red-900">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-white border-t mt-12">
        <div class="container mx-auto px-4 py-6 text-center text-gray-600">
            <p>&copy; 2025 - WebFindLove - <a class="text-primary hover:text-pink-600" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Mobile menu toggle
        document.getElementById('mobile-menu-button')?.addEventListener('click', function() {
            document.getElementById('mobile-menu')?.classList.toggle('hidden');
        });

        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            document.querySelectorAll('[role="alert"]').forEach(function(alert) {
                alert.style.display = 'none';
            });
        }, 5000);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
