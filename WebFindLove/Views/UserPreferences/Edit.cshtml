@model WebFindLove.Models.UserPreference
@{
    ViewData["Title"] = "Chỉnh Sửa Sở Thích";
}

<div class="container mx-auto px-4 py-8 max-w-3xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-purple-600 hover:text-purple-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Quay Lại Sở Thích
        </a>
        <h1 class="text-3xl font-bold text-gray-800 mb-2">
            <i class="fas fa-sliders-h text-purple-600 mr-2"></i>Chỉnh Sửa Sở Thích
        </h1>
        <p class="text-gray-600">Cho chúng tôi biết bạn đang tìm kiếm gì</p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div class="space-y-6">
                <!-- Gender Preference -->
                <div>
                    <label asp-for="PreferredGender" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-venus-mars text-pink-500 mr-1"></i>
                        Giới Tính Mong Muốn
                    </label>
                    <select asp-for="PreferredGender" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                        <option value="">Bất kỳ</option>
                        <option value="male">Nam</option>
                        <option value="female">Nữ</option>
                        <option value="other">Khác</option>
                    </select>
                    <span asp-validation-for="PreferredGender" class="text-red-600 text-sm"></span>
                </div>

                <!-- Age Range -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="AgeMin" class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-birthday-cake text-blue-500 mr-1"></i>
                            Tuổi Tối Thiểu
                        </label>
                        <input asp-for="AgeMin" type="number" min="18" max="100"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 25">
                        <span asp-validation-for="AgeMin" class="text-red-600 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="AgeMax" class="block text-sm font-medium text-gray-700 mb-2">
                            Tuổi Tối Đa
                        </label>
                        <input asp-for="AgeMax" type="number" min="18" max="100"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 35">
                        <span asp-validation-for="AgeMax" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Height Range -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="MinHeight" class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-ruler-vertical text-green-500 mr-1"></i>
                            Chiều Cao Tối Thiểu (cm)
                        </label>
                        <input asp-for="MinHeight" type="number" min="100" max="250"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 160">
                        <span asp-validation-for="MinHeight" class="text-red-600 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="MaxHeight" class="block text-sm font-medium text-gray-700 mb-2">
                            Chiều Cao Tối Đa (cm)
                        </label>
                        <input asp-for="MaxHeight" type="number" min="100" max="250"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 185">
                        <span asp-validation-for="MaxHeight" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Location Preference -->
                <div>
                    <label asp-for="LocationPreference" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-map-marker-alt text-red-500 mr-1"></i>
                        Khu Vực Mong Muốn
                    </label>
                    <input asp-for="LocationPreference" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                           placeholder="VD: Hà Nội, Việt Nam">
                    <span asp-validation-for="LocationPreference" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">Nhập thành phố hoặc khu vực mong muốn</p>
                </div>

                <!-- Personality Preference -->
                <div>
                    <label asp-for="PersonalityPreference" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-brain text-purple-500 mr-1"></i>
                        Tính Cách Mong Muốn (JSON)
                    </label>
                    <textarea asp-for="PersonalityPreference" rows="3"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='{"openness": "high", "extraversion": "medium"}'></textarea>
                    <span asp-validation-for="PersonalityPreference" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Tùy chọn: Định dạng JSON cho đặc điểm tính cách
                    </p>
                </div>

                <!-- Interest Preference -->
                <div>
                    <label asp-for="InterestPreference" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-heart text-pink-500 mr-1"></i>
                        Sở Thích Mong Muốn (JSON)
                    </label>
                    <textarea asp-for="InterestPreference" rows="3"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='["đọc sách", "du lịch", "âm nhạc", "thể thao"]'></textarea>
                    <span asp-validation-for="InterestPreference" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Tùy chọn: Mảng JSON các sở thích
                    </p>
                </div>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex gap-3">
                <button type="submit" 
                        class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Lưu Sở Thích
                </button>
                <a asp-action="Index" 
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition">
                    Hủy
                </a>
            </div>
        </form>
    </div>

    <!-- Help Section -->
    <div class="bg-blue-50 border-l-4 border-blue-500 rounded-lg p-4 mt-6">
        <h3 class="font-semibold text-blue-800 mb-2 flex items-center gap-2">
            <i class="fas fa-lightbulb"></i>
            Mẹo Hay
        </h3>
        <p class="text-blue-700 text-sm">
            Để trống các trường nếu bạn không có yêu cầu cụ thể. AI của chúng tôi sẽ sử dụng thông tin hồ sơ để tìm người phù hợp!
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

