@model WebFindLove.Models.UserPreference
@{
    ViewData["Title"] = "Chỉnh Sửa Sở Thích";
}

<div class="container mx-auto px-4 py-8 max-w-3xl">
    <!-- Header -->
    <div class="mb-6">
        <a asp-action="Index" class="text-purple-600 hover:text-purple-800 mb-4 inline-block">
            <i class="fas fa-arrow-left mr-2"></i>Quay Lại Sở Thích
        </a>
        <h1 class="text-3xl font-bold text-gray-800 mb-2">
            <i class="fas fa-sliders-h text-purple-600 mr-2"></i>Chỉnh Sửa Sở Thích
        </h1>
        <p class="text-gray-600">Cho chúng tôi biết bạn đang tìm kiếm gì</p>
    </div>

    <!-- Free Updates Info -->
    @{
        var freeUpdates = Model.FreeUpdateCount ?? 0;
    }
    <div class="mb-6 @(freeUpdates > 0 ? "bg-blue-50" : "bg-red-50") border-l-4 @(freeUpdates > 0 ? "border-blue-500" : "border-red-500") p-4 rounded-lg">
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <i class="fas fa-sync-alt mr-3 @(freeUpdates > 0 ? "text-blue-500" : "text-red-500")"></i>
                <div>
                    <p class="font-semibold @(freeUpdates > 0 ? "text-blue-800" : "text-red-800")">
                        Số lần cập nhật sở thích còn lại: 
                        <span class="text-2xl font-bold">@freeUpdates</span> lần
                    </p>
                    @if (freeUpdates == 0)
                    {
                        <p class="text-sm text-red-700 mt-1">
                            Bạn đã hết lượt cập nhật miễn phí. Vui lòng liên hệ admin để được hỗ trợ.
                        </p>
                    }
                </div>
            </div>
            @if (freeUpdates > 0)
            {
                <div class="px-4 py-2 bg-blue-100 rounded-full">
                    <span class="text-blue-800 font-semibold">
                        @(freeUpdates == 1 ? "Lượt cuối cùng" : "")
                    </span>
                </div>
            }
        </div>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />

            <div class="space-y-6">
                <!-- Gender Preference -->
                <div>
                    <label asp-for="PreferredGender" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-venus-mars text-pink-500 mr-1"></i>
                        Giới Tính Mong Muốn <span class="text-red-500">*</span>
                    </label>
                    <select asp-for="PreferredGender" 
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                            required>
                        <option value="">Chọn giới tính</option>
                        <option value="male">Nam</option>
                        <option value="female">Nữ</option>
                        <option value="other">Khác</option>
                        <option value="all">Bất kỳ</option>
                    </select>
                    <span asp-validation-for="PreferredGender" class="text-red-600 text-sm"></span>
                </div>

                <!-- Age Range -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="AgeMin" class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-birthday-cake text-blue-500 mr-1"></i>
                            Tuổi Tối Thiểu <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="AgeMin" type="number" min="18" max="100"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 25"
                               required>
                        <span asp-validation-for="AgeMin" class="text-red-600 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="AgeMax" class="block text-sm font-medium text-gray-700 mb-2">
                            Tuổi Tối Đa <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="AgeMax" type="number" min="18" max="100"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 35"
                               required>
                        <span asp-validation-for="AgeMax" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Height Range -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="MinHeight" class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-ruler-vertical text-green-500 mr-1"></i>
                            Chiều Cao Tối Thiểu (cm)
                        </label>
                        <input asp-for="MinHeight" type="number" min="100" max="250"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 160">
                        <span asp-validation-for="MinHeight" class="text-red-600 text-sm"></span>
                    </div>
                    <div>
                        <label asp-for="MaxHeight" class="block text-sm font-medium text-gray-700 mb-2">
                            Chiều Cao Tối Đa (cm)
                        </label>
                        <input asp-for="MaxHeight" type="number" min="100" max="250"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                               placeholder="VD: 185">
                        <span asp-validation-for="MaxHeight" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Location Preference -->
                <div>
                    <label asp-for="LocationPreference" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-map-marker-alt text-red-500 mr-1"></i>
                        Khu Vực Mong Muốn
                    </label>
                    <input asp-for="LocationPreference" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent"
                           placeholder="VD: Hà Nội, Việt Nam">
                    <span asp-validation-for="LocationPreference" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">Nhập thành phố hoặc khu vực mong muốn</p>
                </div>

                <!-- Personality Preference -->
                <div>
                    <label asp-for="PersonalityPreference" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-brain text-purple-500 mr-1"></i>
                        Tính Cách Mong Muốn
                    </label>
                    <textarea asp-for="PersonalityPreference" rows="3"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='Nhập tính cách mong muốn: thân thiện, hài hước, chín chắn, nhiệt tình'></textarea>
                    <span asp-validation-for="PersonalityPreference" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Nhập các tính cách bạn mong muốn (cách nhau bởi dấu phẩy)
                    </p>
                </div>

                <!-- Interest Preference -->
                <div>
                    <label asp-for="InterestPreference" class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-heart text-pink-500 mr-1"></i>
                        Sở Thích Mong Muốn
                    </label>
                    <textarea asp-for="InterestPreference" rows="3"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                              placeholder='Nhập sở thích mong muốn: đọc sách, du lịch, âm nhạc, thể thao'></textarea>
                    <span asp-validation-for="InterestPreference" class="text-red-600 text-sm"></span>
                    <p class="text-sm text-gray-500 mt-1">
                        <i class="fas fa-info-circle mr-1"></i>
                        Nhập các sở thích bạn mong muốn (cách nhau bởi dấu phẩy)
                    </p>
                </div>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex gap-3">
                <button type="submit" 
                        id="submitBtn"
                        @if (freeUpdates == 0) { @:disabled
                        }
                        class="@(freeUpdates == 0 ? "bg-gray-400 cursor-not-allowed" : "bg-purple-600 hover:bg-purple-700") text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    @(freeUpdates == 0 ? "Đã Hết Lượt" : "Lưu Sở Thích")
                </button>
                <a asp-action="Index" 
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg transition">
                    Hủy
                </a>
            </div>
        </form>
    </div>

    <!-- Help Section -->
    <div class="bg-blue-50 border-l-4 border-blue-500 rounded-lg p-4 mt-6">
        <h3 class="font-semibold text-blue-800 mb-2 flex items-center gap-2">
            <i class="fas fa-lightbulb"></i>
            Mẹo Hay
        </h3>
        <p class="text-blue-700 text-sm">
            Để trống các trường nếu bạn không có yêu cầu cụ thể. AI của chúng tôi sẽ sử dụng thông tin hồ sơ để tìm người phù hợp!
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            let isValid = true;
            let errorMessages = [];

            // Validate Age Range
            const ageMin = document.querySelector('input[name="AgeMin"]');
            const ageMax = document.querySelector('input[name="AgeMax"]');
            
            if (ageMin && ageMax && ageMin.value && ageMax.value) {
                const minAge = parseInt(ageMin.value);
                const maxAge = parseInt(ageMax.value);
                
                if (minAge < 18 || minAge > 100) {
                    errorMessages.push('Tuổi tối thiểu phải từ 18 đến 100');
                    ageMin.classList.add('border-red-500');
                    isValid = false;
                } else {
                    ageMin.classList.remove('border-red-500');
                }
                
                if (maxAge < 18 || maxAge > 100) {
                    errorMessages.push('Tuổi tối đa phải từ 18 đến 100');
                    ageMax.classList.add('border-red-500');
                    isValid = false;
                } else {
                    ageMax.classList.remove('border-red-500');
                }
                
                if (minAge > maxAge) {
                    errorMessages.push('Tuổi tối thiểu không được lớn hơn tuổi tối đa');
                    ageMin.classList.add('border-red-500');
                    ageMax.classList.add('border-red-500');
                    isValid = false;
                }
            }

            // Validate Height Range
            const minHeight = document.querySelector('input[name="MinHeight"]');
            const maxHeight = document.querySelector('input[name="MaxHeight"]');
            
            if (minHeight && maxHeight && minHeight.value && maxHeight.value) {
                const minH = parseInt(minHeight.value);
                const maxH = parseInt(maxHeight.value);
                
                if (minH < 100 || minH > 250) {
                    errorMessages.push('Chiều cao tối thiểu phải từ 100 đến 250 cm');
                    minHeight.classList.add('border-red-500');
                    isValid = false;
                } else {
                    minHeight.classList.remove('border-red-500');
                }
                
                if (maxH < 100 || maxH > 250) {
                    errorMessages.push('Chiều cao tối đa phải từ 100 đến 250 cm');
                    maxHeight.classList.add('border-red-500');
                    isValid = false;
                } else {
                    maxHeight.classList.remove('border-red-500');
                }
                
                if (minH > maxH) {
                    errorMessages.push('Chiều cao tối thiểu không được lớn hơn chiều cao tối đa');
                    minHeight.classList.add('border-red-500');
                    maxHeight.classList.add('border-red-500');
                    isValid = false;
                }
            }

            // Validate Gender Selection
            const gender = document.querySelector('select[name="PreferredGender"]');
            if (gender && !gender.value) {
                errorMessages.push('Vui lòng chọn giới tính mong muốn');
                gender.classList.add('border-red-500');
                isValid = false;
            } else if (gender) {
                gender.classList.remove('border-red-500');
            }

            if (!isValid) {
                e.preventDefault();
                alert('Vui lòng kiểm tra lại:\n' + errorMessages.join('\n'));
                return false;
            }
        });

        // Clear error styling on input
        document.querySelectorAll('input, select, textarea').forEach(element => {
            element.addEventListener('input', function() {
                this.classList.remove('border-red-500');
            });
            element.addEventListener('change', function() {
                this.classList.remove('border-red-500');
            });
        });
    </script>
}

